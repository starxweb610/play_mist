<!-- Mobile backdrop -->
<div class="sidebar-overlay" id="devOverlay"></div>

<aside class="sidebar" id="devSidebar">
  <!-- Brand -->
  <div class="brand">
    <a href="/"><img src="/images/play_logo.png" alt="PlayMist" class="brand-logo-img" /></a>
  </div>

  <div class="nav-section">Main</div>

  <a href="/developer/dashboard" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
    </svg>
    <span class="nav-label">Dashboard</span>
  </a>

  <a href="/developer/projects" class="nav-item <%= activePage === 'projects' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
    </svg>
    <span class="nav-label">Projects</span>
  </a>

  <a href="/developer/portfolio" class="nav-item <%= activePage === 'portfolio' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
    </svg>
    <span class="nav-label">Portfolio</span>
  </a>

  <a href="/developer/community" class="nav-item <%= activePage === 'community' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>
    </svg>
    <span class="nav-label">Community</span>
  </a>

  <a href="/developer/listings" class="nav-item <%= activePage === 'listings' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/>
      <polyline points="21 15 16 10 5 21"/>
    </svg>
    <span class="nav-label">Store Listings</span>
  </a>

  <a href="/developer/submit" class="nav-item <%= activePage === 'submit' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
    <span class="nav-label">Submit Your Game</span>
  </a>

  <div class="nav-section">Tools</div>

  <a href="/developer/builder" class="nav-item <%= activePage === 'builder' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
    </svg>
    <span class="nav-label">Game Builder</span>
  </a>

  <a href="/developer/knowledge" class="nav-item <%= activePage === 'knowledge' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>
    <span class="nav-label">Knowledge Sphere</span>
  </a>

  <div class="sidebar-spacer"></div>

  <div class="nav-section">Account</div>

  <!-- User tile — links to profile -->
  <a href="/developer/profile" class="user-tile <%= activePage === 'profile' ? 'active' : '' %>" style="text-decoration:none;">
    <div class="avatar md">
      <% if (developer.avatar_url) { %><img src="<%= developer.avatar_url %>" alt=""><% } else { %><%= developer.name.charAt(0).toUpperCase() %><% } %>
    </div>
    <div class="meta">
      <div class="name"><%= developer.name %></div>
      <div class="role"><%= developer.studio_name %></div>
    </div>
  </a>

  <% if (developer.handle) { %>
  <a href="/@<%= developer.handle %>" target="_blank" rel="noopener" class="nav-item" style="margin-top:4px;">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
    </svg>
    <span class="nav-label">Public profile</span>
  </a>
  <% } %>

  <a href="/developer/logout" class="nav-item" style="margin-top:4px;color:var(--danger);">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
    </svg>
    <span class="nav-label">Log out</span>
  </a>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sidebar = document.getElementById('devSidebar');
    const overlay = document.getElementById('devOverlay');
    const menuBtn = document.getElementById('devMenuBtn');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (menuBtn) menuBtn.addEventListener('click', openSidebar);
    overlay.addEventListener('click', closeSidebar);

    sidebar.querySelectorAll('.nav-item, .user-tile').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.innerWidth <= 768) closeSidebar();
      });
    });
  });
</script>
