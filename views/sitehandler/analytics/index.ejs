<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <link rel="icon" href="/favicon.ico" />
</head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <h2 class="page-heading">Analytics</h2>
        <p class="page-subheading">App usage and game play insights from the Playmist mobile app.</p>
      </div>
      <div class="page-header-actions">
        <a href="/sitehandler/analytics/returning-users" class="btn-admin-ghost">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
          Returning Users
        </a>
        <button type="button" class="btn-admin-primary" id="openEngagementModal">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
          User Engagements
        </button>
      </div>
    </div>

    <!-- User Engagements Modal -->
    <div class="modal-overlay" id="engagementModalOverlay">
      <div class="modal-box" role="dialog" aria-modal="true" aria-labelledby="engagementModalTitle">
        <div class="modal-header">
          <h3 id="engagementModalTitle">User Engagement</h3>
          <button type="button" class="modal-close" id="closeEngagementModal" aria-label="Close">&times;</button>
        </div>
        <p class="modal-subtext">Based on <%= engagement.totalUsers.toLocaleString() %> registered user<%= engagement.totalUsers === 1 ? '' : 's' %>.</p>

        <div class="engagement-metrics">
          <div class="engagement-metric" style="--ic:#7c3aed">
            <div class="engagement-metric-head">
              <span class="engagement-metric-label">Playing Users</span>
              <span class="engagement-metric-value"><%= engagement.playedPct %>%</span>
            </div>
            <div class="engagement-slider">
              <div class="engagement-slider-fill" data-pct="<%= engagement.playedPct %>"></div>
            </div>
            <span class="engagement-metric-sub"><%= engagement.playedUsers.toLocaleString() %> of <%= engagement.totalUsers.toLocaleString() %> users have played at least one game</span>
          </div>

          <div class="engagement-metric" style="--ic:#06b6d4">
            <div class="engagement-metric-head">
              <span class="engagement-metric-label">Returning Users</span>
              <span class="engagement-metric-value"><%= engagement.returningPct %>%</span>
            </div>
            <div class="engagement-slider">
              <div class="engagement-slider-fill" data-pct="<%= engagement.returningPct %>"></div>
            </div>
            <span class="engagement-metric-sub"><%= engagement.returningUsers.toLocaleString() %> of <%= engagement.totalUsers.toLocaleString() %> users transacted on a day after registration</span>
          </div>

          <div class="engagement-metric" style="--ic:#10b981">
            <div class="engagement-metric-head">
              <span class="engagement-metric-label">Engagement Ratio</span>
              <span class="engagement-metric-value"><%= engagement.engagementPct %>%</span>
            </div>
            <div class="engagement-slider">
              <div class="engagement-slider-fill" data-pct="<%= engagement.engagementPct %>"></div>
            </div>
            <span class="engagement-metric-sub"><%= engagement.engagedToday.toLocaleString() %> of <%= engagement.totalUsers.toLocaleString() %> users transacted today</span>
          </div>
        </div>
      </div>
    </div>

    <!-- DAU Trend (full width) -->
    <div class="chart-card chart-card--full">
      <div class="chart-header chart-header--row">
        <div class="chart-title-group">
          <h3>Daily Active Users</h3>
          <select id="dauRange" class="filter-select filter-select--sm" aria-label="Date range for the Daily Active Users chart">
            <% Object.keys(dauRanges).forEach(function (key) { %>
              <option value="<%= key %>" <%= key === dauRangeKey ? 'selected' : '' %>><%= dauRanges[key].label %></option>
            <% }); %>
          </select>
          <span id="dauRangeError" class="dau-range-error" hidden>Couldn't load that range.</span>
        </div>
        <div class="dau-summary">
          <span class="dau-today"><span id="dauTodayValue"><%= todayDau.toLocaleString() %></span> <small>today</small></span>
          <span id="dauDelta" class="dau-delta<%= dauDelta > 0 ? ' dau-delta--up' : (dauDelta < 0 ? ' dau-delta--down' : '') %>">
            <% if (dauDelta !== 0) { %><%= dauDelta > 0 ? '▲' : '▼' %> <%= Math.abs(dauDelta).toLocaleString() %> vs yesterday<% } else { %>— same as yesterday<% } %>
          </span>
        </div>
      </div>
      <div class="chart-body chart-body--lg"><canvas id="dauChart"></canvas></div>
    </div>

    <!-- Returning Players (full width) -->
    <div class="chart-card chart-card--full">
      <div class="chart-header chart-header--row">
        <div class="chart-title-group">
          <h3>Returning Players</h3>
          <select id="returningRange" class="filter-select filter-select--sm" aria-label="Date range for the Returning Players chart">
            <% Object.keys(dauRanges).forEach(function (key) { %>
              <option value="<%= key %>" <%= key === dauRangeKey ? 'selected' : '' %>><%= dauRanges[key].label %></option>
            <% }); %>
          </select>
          <span id="returningRangeError" class="dau-range-error" hidden>Couldn't load that range.</span>
        </div>
        <div class="dau-summary">
          <span class="dau-today"><span id="returningTodayValue"><%= todayReturning.toLocaleString() %></span> <small>today</small></span>
          <span id="returningDelta" class="dau-delta<%= returningDelta > 0 ? ' dau-delta--up' : (returningDelta < 0 ? ' dau-delta--down' : '') %>">
            <% if (returningDelta !== 0) { %><%= returningDelta > 0 ? '▲' : '▼' %> <%= Math.abs(returningDelta).toLocaleString() %> vs yesterday<% } else { %>— same as yesterday<% } %>
          </span>
        </div>
      </div>
      <p class="chart-note">
        Registered players who played a game on a day <strong>after</strong> the first day they were seen —
        so an install and its first session never count here. Each day counts a player once.
      </p>
      <div class="chart-body chart-body--lg"><canvas id="returningChart"></canvas></div>
    </div>

    <!-- Top Stat Tiles -->
    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#7c3aed">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-4l-3 9L9 3l-3 9H2"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Total App Opens</span>
          <span class="stat-card-value"><%= totals.appOpens.toLocaleString() %></span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#06b6d4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Today's Opens</span>
          <span class="stat-card-value"><%= totals.todayOpens.toLocaleString() %></span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#10b981">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12h4M8 10v4M15 12h.01M18 12h.01M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Total Game Plays</span>
          <span class="stat-card-value"><%= totals.gamePlayEvents.toLocaleString() %></span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#f59e0b">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Today's Game Plays</span>
          <span class="stat-card-value"><%= totals.todayPlays.toLocaleString() %></span>
        </div>
      </div>
    </div>

    <!-- Charts Row 1 -->
    <div class="analytics-grid">
      <div class="chart-card chart-card--wide">
        <div class="chart-header">
          <h3>App Opens — Last 14 Days</h3>
        </div>
        <div class="chart-body"><canvas id="appOpensChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-header"><h3>Device Split</h3></div>
        <div class="chart-body chart-body--sm"><canvas id="deviceChart"></canvas></div>
        <div class="device-legend">
          <span class="dl-item"><span class="dl-dot" style="background:#7c3aed"></span>Android: <%= deviceData.android %></span>
          <span class="dl-item"><span class="dl-dot" style="background:#06b6d4"></span>iOS: <%= deviceData.ios %></span>
          <span class="dl-item"><span class="dl-dot" style="background:#4a5068"></span>Other: <%= deviceData.other %></span>
        </div>
      </div>
    </div>

    <!-- Charts Row 2 -->
    <div class="analytics-grid">
      <div class="chart-card chart-card--wide">
        <div class="chart-header"><h3>Game Plays — Last 14 Days</h3></div>
        <div class="chart-body"><canvas id="gamePlaysChart"></canvas></div>
      </div>
      <div class="chart-card">
        <div class="chart-header"><h3>Top Games by Play Count</h3></div>
        <% if (topGames.length > 0) { %>
          <%# Grow with the number of games so every bar gets room for its name. %>
          <div class="chart-body" style="height:<%= Math.max(200, topGames.length * 30 + 40) %>px"><canvas id="topGamesChart"></canvas></div>
        <% } else { %>
          <div class="widget-placeholder" style="min-height:180px"><p>No game play data yet.</p></div>
        <% } %>
      </div>
    </div>

    <!-- API Reference -->
    <div class="dashboard-widget" style="margin-top:20px">
      <div class="widget-header"><h3 class="widget-title">📡 Mobile App API Endpoints</h3></div>
      <div class="api-ref">
        <div class="api-row">
          <span class="api-method">POST</span>
          <code class="api-path">/api/analytics/app-open</code>
          <span class="api-desc">Log app open event — body: <code>{ device, session_id }</code></span>
        </div>
        <div class="api-row">
          <span class="api-method">POST</span>
          <code class="api-path">/api/analytics/game-play</code>
          <span class="api-desc">Log game play event — body: <code>{ device, session_id, game_id }</code></span>
        </div>
        <div class="api-row">
          <span class="api-method">POST</span>
          <code class="api-path">/api/tickets</code>
          <span class="api-desc">Create support ticket — body: <code>{ user_id, subject, message, priority? }</code></span>
        </div>
      </div>
    </div>

  </main>
</div>

<script>
const chartData    = <%- chartData %>;
const topGamesData = <%- topGamesData %>;
const dauData      = <%- dauData %>;
const returningData = <%- returningData %>;

const gridColor  = 'rgba(255,255,255,0.05)';
const tickColor  = '#64748b';
const baseFont   = { family: "'Space Grotesk', sans-serif", size: 12 };
Chart.defaults.color = tickColor;
Chart.defaults.font  = baseFont;

// ── Range-filtered line charts (Daily Active Users, Returning Players) ───────
// Both charts are the same thing over different measures, so they are built by
// the same factory: one place decides how a range change is fetched, applied
// and recovered from, rather than two copies that drift apart the first time
// one of them is fixed.

// Past a couple of months the per-day dots merge into a smear, so they are
// dropped and the line carries the shape; hover still reports the exact day.
const pointRadiusFor = (n) => (n > 60 ? 0 : 3);

function buildRangeChart({ canvasId, label, color, fill, data }) {
  const chart = new Chart(document.getElementById(canvasId), {
    type: 'line',
    data: {
      labels: data.labels,
      datasets: [{
        label: label,
        data:  data.counts,
        borderColor: color,
        backgroundColor: fill,
        borderWidth: 2,
        fill: true,
        tension: 0.3,
        pointBackgroundColor: color,
        pointRadius: pointRadiusFor(data.counts.length),
        pointHoverRadius: 6,
      }]
    },
    options: {
      responsive: true, maintainAspectRatio: false,
      interaction: { mode: 'index', intersect: false },
      plugins: {
        legend: { display: false },
        tooltip: {
          callbacks: {
            // The axis is MM-DD, which is ambiguous once a range crosses a year.
            title: (items) => chart.$dates[items[0].dataIndex] || items[0].label,
          }
        }
      },
      scales: {
        x: { grid: { color: gridColor }, ticks: { color: tickColor, maxTicksLimit: 15, maxRotation: 0 } },
        y: { grid: { color: gridColor }, ticks: { color: tickColor, stepSize: 1, precision: 0 }, beginAtZero: true }
      }
    }
  });
  chart.$dates = data.dates || [];
  return chart;
}

function wireRangeDropdown({ chart, endpoint, selectId, errorId, todayId, deltaId }) {
  const select  = document.getElementById(selectId);
  const errorEl = document.getElementById(errorId);
  const todayEl = document.getElementById(todayId);
  const deltaEl = document.getElementById(deltaId);
  if (!select) return;

  // Every change supersedes the one before it: a slow 1-year response must not
  // land after a fast 7-day one and leave the chart disagreeing with the
  // dropdown. Only the newest request is allowed to draw.
  let latest = 0;

  select.addEventListener('change', async () => {
    const token = ++latest;
    select.disabled = true;
    errorEl.hidden  = true;

    try {
      const res = await fetch(endpoint + '?range=' + encodeURIComponent(select.value), {
        headers: { 'Accept': 'application/json' },
        credentials: 'same-origin',
      });
      if (!res.ok) throw new Error('HTTP ' + res.status);
      const data = await res.json();
      if (token !== latest) return;

      chart.data.labels = data.labels;
      chart.data.datasets[0].data = data.counts;
      chart.data.datasets[0].pointRadius = pointRadiusFor(data.counts.length);
      chart.$dates = data.dates || [];
      chart.update();

      todayEl.textContent = Number(data.todayDau).toLocaleString();
      const delta = Number(data.dauDelta);
      deltaEl.className = 'dau-delta' + (delta > 0 ? ' dau-delta--up' : (delta < 0 ? ' dau-delta--down' : ''));
      deltaEl.textContent = delta === 0
        ? '— same as yesterday'
        : (delta > 0 ? '▲ ' : '▼ ') + Math.abs(delta).toLocaleString() + ' vs yesterday';
    } catch (err) {
      if (token !== latest) return;
      // Leave the previous range on screen. A chart redrawn flat on a failed
      // request reads as "nobody used the app", which is a worse lie than an
      // error message.
      console.error('Range load failed for ' + endpoint + ':', err);
      errorEl.hidden = false;
    } finally {
      if (token === latest) select.disabled = false;
    }
  });
}

const dauChart = buildRangeChart({
  canvasId: 'dauChart', label: 'Daily Active Users',
  color: '#10b981', fill: 'rgba(16,185,129,0.10)', data: dauData,
});
wireRangeDropdown({
  chart: dauChart, endpoint: '/sitehandler/analytics/dau',
  selectId: 'dauRange', errorId: 'dauRangeError',
  todayId: 'dauTodayValue', deltaId: 'dauDelta',
});

const returningChart = buildRangeChart({
  canvasId: 'returningChart', label: 'Returning Players',
  color: '#7c3aed', fill: 'rgba(124,58,237,0.10)', data: returningData,
});
wireRangeDropdown({
  chart: returningChart, endpoint: '/sitehandler/analytics/returning-series',
  selectId: 'returningRange', errorId: 'returningRangeError',
  todayId: 'returningTodayValue', deltaId: 'returningDelta',
});

// App Opens Line Chart
new Chart(document.getElementById('appOpensChart'), {
  type: 'line',
  data: {
    labels: chartData.labels,
    datasets: [{
      label: 'App Opens',
      data:  chartData.openCounts,
      borderColor: '#7c3aed',
      backgroundColor: 'rgba(124,58,237,0.12)',
      borderWidth: 2,
      fill: true,
      tension: 0.4,
      pointBackgroundColor: '#7c3aed',
      pointRadius: 4,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: gridColor }, ticks: { color: tickColor } },
      y: { grid: { color: gridColor }, ticks: { color: tickColor, stepSize: 1, precision: 0 }, beginAtZero: true }
    }
  }
});

// Game Plays Line Chart
new Chart(document.getElementById('gamePlaysChart'), {
  type: 'line',
  data: {
    labels: chartData.labels,
    datasets: [{
      label: 'Game Plays',
      data:  chartData.playCounts,
      borderColor: '#06b6d4',
      backgroundColor: 'rgba(6,182,212,0.1)',
      borderWidth: 2,
      fill: true,
      tension: 0.4,
      pointBackgroundColor: '#06b6d4',
      pointRadius: 4,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: gridColor }, ticks: { color: tickColor } },
      y: { grid: { color: gridColor }, ticks: { color: tickColor, stepSize: 1, precision: 0 }, beginAtZero: true }
    }
  }
});

// Device Doughnut
new Chart(document.getElementById('deviceChart'), {
  type: 'doughnut',
  data: {
    labels: ['Android','iOS','Other'],
    datasets: [{
      data: [<%= deviceData.android %>, <%= deviceData.ios %>, <%= deviceData.other %>],
      backgroundColor: ['#7c3aed','#06b6d4','#4a5068'],
      borderWidth: 0,
      hoverOffset: 6,
    }]
  },
  options: {
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    cutout: '68%',
  }
});

// Top Games Bar
<% if (topGames.length > 0) { %>
new Chart(document.getElementById('topGamesChart'), {
  type: 'bar',
  data: {
    labels: topGamesData.labels,
    datasets: [{
      label: 'Plays',
      data: topGamesData.data,
      backgroundColor: 'rgba(124,58,237,0.7)',
      borderRadius: 6,
    }]
  },
  options: {
    indexAxis: 'y',
    responsive: true, maintainAspectRatio: false,
    plugins: { legend: { display: false } },
    scales: {
      x: { grid: { color: gridColor }, ticks: { color: tickColor }, beginAtZero: true },
      y: {
        grid: { display: false },
        ticks: {
          color: tickColor,
          // Chart.js skips labels it thinks won't fit (every other game) — show them all.
          autoSkip: false,
          // Shorten long titles on the axis; the tooltip still shows the full name.
          callback: function (value) {
            const label = this.getLabelForValue(value);
            return label.length > 22 ? label.slice(0, 21) + '…' : label;
          }
        }
      }
    }
  }
});
<% } %>

// User Engagements Modal
(function initEngagementModal() {
  const openBtn  = document.getElementById('openEngagementModal');
  const closeBtn = document.getElementById('closeEngagementModal');
  const overlay  = document.getElementById('engagementModalOverlay');
  if (!openBtn || !overlay) return;

  const fills = overlay.querySelectorAll('.engagement-slider-fill');

  const openModal = () => {
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
    // Animate fills from 0 -> target pct on each open
    fills.forEach(f => { f.style.width = '0%'; });
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        fills.forEach(f => { f.style.width = (f.dataset.pct || 0) + '%'; });
      });
    });
  };

  const closeModal = () => {
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  };

  openBtn.addEventListener('click', openModal);
  closeBtn && closeBtn.addEventListener('click', closeModal);
  overlay.addEventListener('click', (e) => { if (e.target === overlay) closeModal(); });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && overlay.classList.contains('is-open')) closeModal();
  });
})();
</script>
<script src="/sitehandler/js/admin.js"></script>
</body>
</html>
