<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/head') %>
  <link rel="icon" href="/favicon.ico" />
  <style>
    .ru-note {
      margin: 0 0 18px; padding: 12px 16px;
      background: rgba(124,58,237,0.06);
      border: 1px solid rgba(124,58,237,0.18);
      border-radius: 10px;
      font-size: 0.82rem; color: var(--a-text-muted); line-height: 1.6;
    }
    .ru-note strong { color: var(--a-text); }

    .ru-toggle {
      display: inline-flex; align-items: center; justify-content: center;
      width: 26px; height: 26px; border-radius: 6px;
      border: 1px solid var(--a-border); background: transparent;
      color: var(--a-text-muted); cursor: pointer; transition: all var(--a-trans);
    }
    .ru-toggle:hover { border-color: rgba(124,58,237,0.4); color: var(--a-text); }
    .ru-toggle svg { width: 14px; height: 14px; transition: transform var(--a-trans); }
    .ru-row.is-open .ru-toggle svg { transform: rotate(90deg); }
    .ru-row.is-open { background: rgba(124,58,237,0.04); }

    .ru-detail-row > td { padding: 0 !important; border-bottom: 1px solid var(--a-border); }
    .ru-detail-inner { padding: 16px 18px 20px; background: rgba(255,255,255,0.015); }
    .ru-detail-title {
      font-size: 0.75rem; text-transform: uppercase; letter-spacing: .06em;
      color: var(--a-text-dim); margin: 0 0 12px;
    }

    .ru-games { display: grid; gap: 8px; }
    .ru-game {
      display: grid;
      grid-template-columns: 34px minmax(140px, 1.4fr) 1fr auto;
      align-items: center; gap: 12px;
      padding: 9px 12px; border-radius: 9px;
      background: var(--a-card-bg, rgba(255,255,255,0.02));
      border: 1px solid var(--a-border);
    }
    .ru-game--repeat { border-color: rgba(16,185,129,0.28); background: rgba(16,185,129,0.05); }
    .ru-game-thumb {
      width: 34px; height: 34px; border-radius: 7px; object-fit: cover;
      background: linear-gradient(135deg,#7c3aed,#4f46e5);
      display: flex; align-items: center; justify-content: center;
      font-size: 0.8rem; font-weight: 700; color: #fff; flex-shrink: 0;
    }
    .ru-game-name { font-weight: 600; font-size: 0.86rem; }
    .ru-game-dates { font-size: 0.72rem; color: var(--a-text-dim); margin-top: 2px; }
    .ru-bar { height: 6px; border-radius: 99px; background: rgba(255,255,255,0.07); overflow: hidden; }
    .ru-bar-fill { height: 100%; border-radius: 99px; background: linear-gradient(90deg,#7c3aed,#06b6d4); }
    .ru-game--repeat .ru-bar-fill { background: linear-gradient(90deg,#10b981,#06b6d4); }
    .ru-game-count { font-size: 0.8rem; white-space: nowrap; text-align: right; }
    .ru-game-count strong { color: var(--a-text); font-size: 0.95rem; }

    .ru-hidden { display: none !important; }
    .ru-summary-line { font-size: 0.82rem; color: var(--a-text-dim); margin: 14px 0 8px; }

    @media (max-width: 720px) {
      .ru-game { grid-template-columns: 34px 1fr auto; }
      .ru-game .ru-bar { display: none; }
    }

    /* Date window controls */
    .ru-window {
      display: flex; flex-wrap: wrap; align-items: flex-end; gap: 10px;
      margin: 0 0 16px; padding: 14px 16px;
      background: var(--a-card); border: 1px solid var(--a-border);
      border-radius: var(--a-radius);
    }
    .ru-window-field { display: flex; flex-direction: column; gap: 5px; }
    .ru-window-field label {
      font-size: 0.7rem; font-weight: 700; text-transform: uppercase;
      letter-spacing: .06em; color: var(--a-text-dim);
    }
    .ru-date {
      padding: 8px 10px; background: var(--a-card-2, rgba(255,255,255,0.03));
      border: 1px solid var(--a-border); border-radius: 8px;
      color: var(--a-text); font-size: 0.85rem; color-scheme: dark;
    }
    .ru-date:focus { outline: none; border-color: rgba(124,58,237,0.4); }
    .ru-window-presets { display: flex; flex-wrap: wrap; gap: 8px; margin-left: auto; }
    .ru-window-presets a { text-decoration: none; }
    .ru-window-label {
      font-size: 0.78rem; color: var(--a-text-dim);
      width: 100%; margin: 2px 0 0;
    }
    .ru-window-label strong { color: var(--a-text); }

    /* Day-by-day breakdown */
    .ru-section-head { margin: 26px 0 12px; }
    .ru-section-head h3 { margin: 0 0 4px; font-size: 1.02rem; }
    .ru-section-head p  { margin: 0; font-size: 0.8rem; color: var(--a-text-dim); }
    .ru-day-games { display: grid; gap: 8px; }
    .ru-day-game {
      display: grid; grid-template-columns: 34px minmax(140px, 1fr) auto;
      align-items: center; gap: 12px;
      padding: 9px 12px; border-radius: 9px;
      background: var(--a-card-bg, rgba(255,255,255,0.02));
      border: 1px solid var(--a-border);
    }
    .ru-players { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 5px; }
    .ru-player {
      font-size: 0.71rem; padding: 2px 7px; border-radius: 99px;
      background: rgba(124,58,237,0.12); border: 1px solid rgba(124,58,237,0.22);
      color: #a78bfa; white-space: nowrap;
    }
    .ru-dates { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 4px; }
    .ru-date-chip {
      font-size: 0.68rem; padding: 1px 6px; border-radius: 5px;
      background: rgba(255,255,255,0.05); color: var(--a-text-dim);
    }
  </style>
</head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <h2 class="page-heading">Returning Users</h2>
        <p class="page-subheading">Players who came back on a later day than their first day — and the games they keep replaying.</p>
      </div>
      <div class="page-header-actions">
        <a href="/sitehandler/analytics" class="btn-admin-ghost">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/></svg>
          Back to Analytics
        </a>
      </div>
    </div>

    <form class="ru-window" method="get" action="/sitehandler/analytics/returning-users" id="ruWindowForm">
      <div class="ru-window-field">
        <label for="ruFrom">From</label>
        <input type="date" id="ruFrom" name="from" class="ru-date" value="<%= win.from || '' %>" />
      </div>
      <div class="ru-window-field">
        <label for="ruTo">To</label>
        <input type="date" id="ruTo" name="to" class="ru-date" value="<%= win.to || '' %>" />
      </div>
      <button type="submit" class="filter-chip filter-chip--active">Apply dates</button>

      <div class="ru-window-presets">
        <% Object.keys(windows).forEach(k => { %>
          <a class="filter-chip <%= win.key === k ? 'filter-chip--active' : '' %>"
             href="/sitehandler/analytics/returning-users<%= k === 'all' ? '' : '?window=' + k %>"><%= windows[k].label %></a>
        <% }) %>
      </div>

      <p class="ru-window-label">
        Showing <strong><%= win.label %></strong><% if (win.key !== 'all') { %> — every count on this page is for that
        window only; the “first seen” baseline that decides who counts as returning still spans all history.<% } %>
      </p>
    </form>

    <p class="ru-note">
      <strong>How this list is built:</strong> a user appears here only if they were active on
      <strong>2 or more different days</strong> — i.e. they opened the app or played a game on at least one day
      <em>after</em> their first (install) day — <strong>and</strong> they have played at least one game.
      One-time installs who played once and never came back are excluded.
      Activity is counted once per user per day, so “days played” is the number of distinct days a game was opened.
      <br />
      <strong>With a date filter on,</strong> a user is listed when one of their active days <em>inside the window</em>
      falls after their first-ever day, and they played a game inside it — so the numbers describe that period,
      not all-time totals trimmed to it.
    </p>

    <!-- Summary tiles -->
    <div class="stat-cards">
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#10b981">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 102.13-9.36L1 10"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Returning Users</span>
          <span class="stat-card-value"><%= summary.returningUsers.toLocaleString() %></span>
          <span class="stat-card-label">
            <% if (summary.daysCovered) { %>returning play on <%= summary.daysCovered %> day<%= summary.daysCovered === 1 ? '' : 's' %> in this window<% } else { %>no returning play in this window<% } %>
          </span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#7c3aed">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Retention Rate</span>
          <span class="stat-card-value"><%= summary.returningPct %>%</span>
          <span class="stat-card-label">of <%= summary.totalActiveUsers.toLocaleString() %> users seen in-app</span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#06b6d4">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Avg. Active Days</span>
          <span class="stat-card-value"><%= summary.avgActiveDays %></span>
        </div>
      </div>
      <div class="stat-card">
        <div class="stat-card-icon" style="--ic:#f59e0b">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12h4M8 10v4M15 12h.01M18 12h.01M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/></svg>
        </div>
        <div class="stat-card-body">
          <span class="stat-card-label">Replaying a Game</span>
          <span class="stat-card-value"><%= summary.repeatGamePlayers.toLocaleString() %></span>
          <span class="stat-card-label">played the same game on 2+ days</span>
        </div>
      </div>
    </div>

    <div class="ru-section-head">
      <h3>Day by day</h3>
      <p>Each date in this window, how many returning players played that day, and exactly what they played.
         A play counts here when it happened on a day later than that player’s first-ever day.</p>
    </div>

    <% if (byDate.length > 0) { %>
      <div class="data-table-wrapper">
        <table class="data-table" id="ruDayTable">
          <thead>
            <tr>
              <th style="width:40px;"></th>
              <th>Date</th>
              <th>Returning Players</th>
              <th>Games Played</th>
              <th>Plays</th>
              <th>Most Played That Day</th>
            </tr>
          </thead>
          <tbody id="ruDayTbody">
            <% byDate.forEach(d => { %>
              <tr class="ru-row ru-day-row" data-date="<%= d.date %>">
                <td>
                  <button type="button" class="ru-toggle" aria-label="Show games played on <%= d.date %>">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                </td>
                <td class="fw-600"><%= d.date %></td>
                <td><span class="badge badge--active"><%= d.returningUsers %></span></td>
                <td><%= d.gameCount %></td>
                <td><strong style="color: var(--accent-color);"><%= d.plays %></strong></td>
                <td class="text-sm">
                  <% if (d.topGame) { %>
                    <%= d.topGame.title %>
                    <span class="text-dim">· <%= d.topGame.players.length %> player<%= d.topGame.players.length === 1 ? '' : 's' %></span>
                  <% } else { %><span class="text-dim">—</span><% } %>
                </td>
              </tr>
              <tr class="ru-detail-row ru-hidden" data-day-detail-for="<%= d.date %>">
                <td colspan="6">
                  <div class="ru-detail-inner">
                    <p class="ru-detail-title">Games played by returning players on <%= d.date %></p>
                    <div class="ru-day-games">
                      <% d.games.forEach(g => { %>
                        <div class="ru-day-game">
                          <% if (g.thumbnail) { %>
                            <img class="ru-game-thumb" src="<%= g.thumbnail %>" alt="" />
                          <% } else { %>
                            <div class="ru-game-thumb"><%= g.title.charAt(0).toUpperCase() %></div>
                          <% } %>
                          <div>
                            <div class="ru-game-name"><%= g.title %></div>
                            <div class="ru-players">
                              <% g.players.forEach(pl => { %>
                                <span class="ru-player">@<%= pl.username %></span>
                              <% }) %>
                            </div>
                          </div>
                          <div class="ru-game-count">
                            <strong><%= g.players.length %></strong> player<%= g.players.length === 1 ? '' : 's' %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="widget-placeholder" style="min-height:140px">
        <p>No returning play was recorded on any date in this window.</p>
      </div>
    <% } %>

    <div class="ru-section-head">
      <h3>Players</h3>
      <p>One row per returning player, with every game they played in this window.</p>
    </div>

    <% if (users.length > 0) { %>
      <div class="filter-bar" style="margin-top:18px">
        <input type="text" id="ruSearch" class="filter-input" placeholder="Search player, email or game…" autocomplete="off" />

        <div class="filter-group">
          <label class="filter-label">Min active days</label>
          <input type="number" id="ruMinDays" class="filter-select filter-num" min="2" placeholder="2" />
        </div>

        <select id="ruSort" class="filter-select">
          <option value="days">Sort: Most active days</option>
          <option value="plays">Sort: Most plays</option>
          <option value="repeat">Sort: Most replayed games</option>
          <option value="last">Sort: Most recently seen</option>
        </select>

        <button type="button" id="ruRepeatOnly" class="filter-chip">Only replayed games</button>
        <button type="button" id="ruExpandAll" class="filter-chip">Expand all</button>
        <button type="button" id="ruReset" class="filter-chip filter-chip--ghost">Reset</button>
      </div>

      <p class="ru-summary-line" id="ruSummary"></p>

      <div class="data-table-wrapper">
        <table class="data-table" id="ruTable">
          <thead>
            <tr>
              <th style="width:40px;"></th>
              <th>Player</th>
              <th>Active Days</th>
              <th>First Seen</th>
              <th>Last Seen</th>
              <th>Games</th>
              <th>Replayed</th>
              <th>Total Plays</th>
              <th>Most Played</th>
            </tr>
          </thead>
          <tbody id="ruTbody">
            <% users.forEach(u => {
                 const activeDays  = Number(u.active_days) || 0;
                 const totalPlays  = Number(u.total_plays) || 0;
                 const gamesPlayed = Number(u.games_played) || 0;
                 const repeatCount = u.repeatGames.length;
                 const sinceLast   = Number(u.days_since_last_seen) || 0;
                 const maxDays     = u.games.length ? u.games[0].playDays : 1;
                 const searchBlob  = [u.username, u.email || '']
                                       .concat(u.games.map(g => g.title))
                                       .join(' ').toLowerCase();
            %>
              <tr class="ru-row"
                  data-uid="<%= u.id %>"
                  data-search="<%= searchBlob %>"
                  data-days="<%= activeDays %>"
                  data-plays="<%= totalPlays %>"
                  data-games="<%= gamesPlayed %>"
                  data-repeat="<%= repeatCount %>"
                  data-last="<%= u.lastDay %>">
                <td>
                  <button type="button" class="ru-toggle" aria-label="Show games">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="9 18 15 12 9 6"/></svg>
                  </button>
                </td>
                <td>
                  <div class="game-title-cell">
                    <div class="admin-avatar-sm" style="background:linear-gradient(135deg, #B5FF6B, #9B7DFF);color:#0B0911"><%= u.username.charAt(0).toUpperCase() %></div>
                    <div>
                      <div class="fw-600">@<%= u.username %></div>
                      <div class="text-sm text-dim"><%= u.email %></div>
                    </div>
                  </div>
                </td>
                <td><span class="badge badge--active"><%= activeDays %> days</span></td>
                <td class="text-sm text-dim"><%= u.firstDay %></td>
                <td class="text-sm">
                  <%= u.lastDay %>
                  <div class="text-sm text-dim">
                    <%= sinceLast === 0 ? 'today' : (sinceLast === 1 ? 'yesterday' : sinceLast + ' days ago') %>
                  </div>
                </td>
                <td><%= gamesPlayed %></td>
                <td>
                  <% if (repeatCount > 0) { %>
                    <span class="badge badge--count"><%= repeatCount %></span>
                  <% } else { %>
                    <span class="text-dim">0</span>
                  <% } %>
                </td>
                <td><strong style="color: var(--accent-color);"><%= totalPlays %></strong></td>
                <td class="text-sm">
                  <% if (u.topGame) { %>
                    <%= u.topGame.title %>
                    <span class="text-dim">· <%= u.topGame.playDays %> day<%= u.topGame.playDays === 1 ? '' : 's' %></span>
                  <% } else { %>
                    <span class="text-dim">—</span>
                  <% } %>
                </td>
              </tr>
              <tr class="ru-detail-row ru-hidden" data-detail-for="<%= u.id %>">
                <td colspan="9">
                  <div class="ru-detail-inner">
                    <p class="ru-detail-title">Games played by @<%= u.username %> — highlighted rows were played on more than one day</p>
                    <div class="ru-games">
                      <% u.games.forEach(g => { %>
                        <div class="ru-game <%= g.playDays >= 2 ? 'ru-game--repeat' : '' %>">
                          <% if (g.thumbnail) { %>
                            <img class="ru-game-thumb" src="<%= g.thumbnail %>" alt="" />
                          <% } else { %>
                            <div class="ru-game-thumb"><%= g.title.charAt(0).toUpperCase() %></div>
                          <% } %>
                          <div>
                            <div class="ru-game-name"><%= g.title %></div>
                            <div class="ru-game-dates"><%= g.firstPlayed %> → <%= g.lastPlayed %></div>
                            <div class="ru-dates">
                              <% g.dates.forEach(dt => { %><span class="ru-date-chip"><%= dt %></span><% }) %>
                            </div>
                          </div>
                          <div class="ru-bar">
                            <div class="ru-bar-fill" style="width: <%= Math.max(6, Math.round((g.playDays / maxDays) * 100)) %>%"></div>
                          </div>
                          <div class="ru-game-count">
                            <strong><%= g.playDays %></strong> day<%= g.playDays === 1 ? '' : 's' %>
                          </div>
                        </div>
                      <% }) %>
                    </div>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <div class="widget-placeholder ru-hidden" id="ruEmpty" style="min-height:120px"><p>No players match these filters.</p></div>
    <% } else { %>
      <div class="widget-placeholder" style="min-height:200px;margin-top:18px">
        <p>
          <% if (win.key === 'all') { %>
            No returning users yet — nobody has come back on a day after their first day (and played a game).
          <% } else { %>
            No returning users in <%= win.label %> — nobody who had been seen before played a game in this window.
            Try a wider range, or <a href="/sitehandler/analytics/returning-users">view all time</a>.
          <% } %>
        </p>
      </div>
    <% } %>

  </main>
</div>

<script>
// Day-by-day table: its own opener, so it still works on a window where no
// player rows rendered below it.
(function initReturningDays() {
  const tbody = document.getElementById('ruDayTbody');
  if (!tbody) return;

  const details = new Map();
  tbody.querySelectorAll('.ru-detail-row').forEach(d => details.set(d.dataset.dayDetailFor, d));

  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('.ru-toggle');
    if (!btn) return;
    const row    = btn.closest('.ru-day-row');
    const detail = details.get(row.dataset.date);
    const open   = !row.classList.contains('is-open');
    row.classList.toggle('is-open', open);
    if (detail) detail.classList.toggle('ru-hidden', !open);
  });
})();

// Picking a date submits the window form, so the page reloads with data for
// that range instead of filtering only what the current range already sent.
(function initWindowForm() {
  const form = document.getElementById('ruWindowForm');
  if (!form) return;
  form.querySelectorAll('.ru-date').forEach(input => {
    input.addEventListener('change', () => {
      const from = form.from.value, to = form.to.value;
      if (from && to) form.submit();   // both ends set — go
    });
  });
})();
</script>

<script>
(function initReturningUsers() {
  const tbody = document.getElementById('ruTbody');
  if (!tbody) return;

  const rows    = Array.from(tbody.querySelectorAll('.ru-row'));
  const details = new Map();
  tbody.querySelectorAll('.ru-detail-row').forEach(d => details.set(d.dataset.detailFor, d));

  const el = {
    search:     document.getElementById('ruSearch'),
    minDays:    document.getElementById('ruMinDays'),
    sort:       document.getElementById('ruSort'),
    repeatOnly: document.getElementById('ruRepeatOnly'),
    expandAll:  document.getElementById('ruExpandAll'),
    reset:      document.getElementById('ruReset'),
    summary:    document.getElementById('ruSummary'),
    empty:      document.getElementById('ruEmpty'),
    table:      document.getElementById('ruTable'),
  };

  let repeatOnly = false;
  let allExpanded = false;

  function detailOf(row) { return details.get(row.dataset.uid); }

  function setOpen(row, open) {
    const detail = detailOf(row);
    row.classList.toggle('is-open', open);
    if (detail) detail.classList.toggle('ru-hidden', !open || row.classList.contains('ru-hidden'));
  }

  function apply() {
    const q       = (el.search.value || '').trim().toLowerCase();
    const minDays = el.minDays.value !== '' ? Number(el.minDays.value) : null;

    let visible = 0;
    rows.forEach(row => {
      const d = row.dataset;
      let show = true;
      if (q && !d.search.includes(q)) show = false;
      if (minDays !== null && Number(d.days) < minDays) show = false;
      if (repeatOnly && Number(d.repeat) < 1) show = false;

      row.classList.toggle('ru-hidden', !show);
      const detail = detailOf(row);
      if (detail) detail.classList.toggle('ru-hidden', !show || !row.classList.contains('is-open'));
      if (show) visible++;
    });

    // Sort visible + hidden alike, keeping each detail row right after its parent.
    const key = el.sort.value;
    const sorted = rows.slice().sort((a, b) => {
      if (key === 'last') return String(b.dataset.last).localeCompare(String(a.dataset.last));
      return Number(b.dataset[key]) - Number(a.dataset[key]);
    });
    sorted.forEach(row => {
      tbody.appendChild(row);
      const detail = detailOf(row);
      if (detail) tbody.appendChild(detail);
    });

    el.summary.textContent = visible === 1
      ? '1 returning player'
      : visible + ' returning players';
    el.empty.classList.toggle('ru-hidden', visible !== 0);
    el.table.style.display = visible === 0 ? 'none' : '';
  }

  tbody.addEventListener('click', (e) => {
    const btn = e.target.closest('.ru-toggle');
    if (!btn) return;
    const row = btn.closest('.ru-row');
    setOpen(row, !row.classList.contains('is-open'));
  });

  let debounce;
  el.search.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(apply, 120); });
  el.minDays.addEventListener('input', () => { clearTimeout(debounce); debounce = setTimeout(apply, 120); });
  el.sort.addEventListener('change', apply);

  el.repeatOnly.addEventListener('click', () => {
    repeatOnly = !repeatOnly;
    el.repeatOnly.classList.toggle('filter-chip--active', repeatOnly);
    apply();
  });

  el.expandAll.addEventListener('click', () => {
    allExpanded = !allExpanded;
    el.expandAll.textContent = allExpanded ? 'Collapse all' : 'Expand all';
    el.expandAll.classList.toggle('filter-chip--active', allExpanded);
    rows.forEach(row => { if (!row.classList.contains('ru-hidden')) setOpen(row, allExpanded); });
  });

  el.reset.addEventListener('click', () => {
    el.search.value = '';
    el.minDays.value = '';
    el.sort.value = 'days';
    repeatOnly = false;
    el.repeatOnly.classList.remove('filter-chip--active');
    apply();
  });

  apply();
})();
</script>
<script src="/sitehandler/js/admin.js"></script>
</body>
</html>
