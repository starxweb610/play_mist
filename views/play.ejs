<!DOCTYPE html>
<html lang="en" class="play-root">
<head>
  <meta charset="UTF-8" />
  <%- include('partials/analytics') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <!-- SEO: player page has no crawlable content; game detail page is the SEO landing page -->
  <title><%= title %></title>
  <meta name="robots" content="noindex, nofollow" />
  <link rel="canonical" href="<%= appUrl %>/games/<%= game.slug %>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800;12..96,900&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" />
</head>
<body class="play-body">

  <!-- ─── PLAYER BAR ───────────────────────────────────────────────────── -->
  <!-- No data-aos here on purpose: [data-aos] starts at opacity:0 and is only
       revealed by main.js's IntersectionObserver. On every other page that is a
       nicety, but this bar holds the only way out of a game — if main.js fails
       to load the player would be trapped on an invisible header. -->
  <header class="player-bar">
    <a href="/games/<%= game.slug %>" class="player-back" aria-label="Back to game details">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <span class="player-back-text">Back</span>
    </a>
    <div class="player-title">
      <img src="/images/play_logo.png" alt="PlayMist" class="player-logo-img" />
      <span><%= game.title %></span>
    </div>
    <button class="player-fullscreen" id="fullscreenBtn" aria-label="Toggle fullscreen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
      <span class="player-fullscreen-text">Fullscreen</span>
    </button>
  </header>

  <!-- ─── GAME FRAME ───────────────────────────────────────────────────── -->
  <main class="player-stage player-stage--<%= game.orientation %>" id="playerStage">
    <iframe
      id="gameFrame"
      src="<%= playUrl %>"
      title="<%= game.title %>"
      class="player-frame"
      allow="autoplay; fullscreen; gamepad; accelerometer; gyroscope; pointer-lock"
      allowfullscreen
      loading="eager"
      sandbox="allow-scripts allow-same-origin allow-forms allow-pointer-lock allow-popups">
    </iframe>

    <!-- Shown only on a touch device held in portrait while the game inside is
         built for landscape. Purely CSS-driven (see .player-rotate) so it works
         even if main.js never loads; the escape hatch below needs JS, which is
         the right way round. -->
    <div class="player-rotate" id="rotatePrompt">
      <div class="player-rotate-phone" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
          <rect x="7" y="2" width="10" height="20" rx="2" />
          <path d="M11 18.5h2" />
        </svg>
      </div>
      <p class="player-rotate-title">Rotate your device</p>
      <p class="player-rotate-sub"><%= game.title %> plays in landscape.</p>
      <!-- Rotation lock would otherwise trap the player behind this overlay. -->
      <button type="button" class="player-rotate-skip" id="rotateSkip">Play in portrait anyway</button>
    </div>
  </main>

  <script src="/js/main.js"></script>
  <script>
    (function () {
      const btn   = document.getElementById('fullscreenBtn');
      const stage = document.getElementById('playerStage');
      const root  = document.documentElement;

      /* ── Visible-viewport height ──────────────────────────────────────────
         iOS Safari reports `100vh` as the viewport it *would* have with the
         toolbars hidden, so the bottom bar overlaps the game. Publish the real
         on-screen height as `--app-h` for browsers without `dvh` support
         (iOS 15.0-15.3); everywhere else the CSS `@supports (height: 100dvh)`
         rule takes over and this value is simply ignored. */
      const setAppHeight = () => {
        const vv = window.visualViewport;
        // visualViewport excludes the browser chrome; innerHeight is the fallback.
        const h = vv ? vv.height : window.innerHeight;
        root.style.setProperty('--app-h', h + 'px');
      };

      setAppHeight();
      window.addEventListener('resize', setAppHeight);
      window.addEventListener('orientationchange', () => {
        // Safari reports stale metrics until after the rotation settles.
        setAppHeight();
        setTimeout(setAppHeight, 250);
      });
      if (window.visualViewport) {
        window.visualViewport.addEventListener('resize', setAppHeight);
      }

      /* Swallow page-level touch drags so a swipe on the game never
         rubber-bands the document or re-animates the Safari toolbars. The
         iframe gets its own events, so the game itself is unaffected. */
      document.addEventListener('touchmove', (e) => {
        if (e.touches.length === 1) e.preventDefault();
      }, { passive: false });

      /* ── Fullscreen ───────────────────────────────────────────────────────
         iPhone Safari has no element-level Fullscreen API (video only), so the
         button would throw on tap. Hide it when there is nothing to call. */
      const request = stage.requestFullscreen || stage.webkitRequestFullscreen || stage.msRequestFullscreen;
      const exit    = document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen;

      if (!request) {
        // Keep the element in the flex row so the centred title stays centred.
        btn.classList.add('is-unavailable');
      } else {
        btn.addEventListener('click', () => {
          const active = document.fullscreenElement || document.webkitFullscreenElement;
          if (active) {
            if (exit) exit.call(document);
          } else {
            Promise.resolve(request.call(stage)).catch(() => {});
          }
        });
      }

      /* The rotate prompt shows and hides purely in CSS. All this adds is the
         escape hatch for anyone with rotation lock switched on, who cannot
         satisfy the prompt and would otherwise be stuck behind it. The opt-out
         lasts for this page view only. */
      const skip = document.getElementById('rotateSkip');
      if (skip) {
        skip.addEventListener('click', () => {
          document.body.classList.add('rotate-dismissed');
        });
      }

      const onFsChange = () => {
        const active = !!(document.fullscreenElement || document.webkitFullscreenElement);
        stage.classList.toggle('is-fullscreen', active);
        setAppHeight();
      };
      document.addEventListener('fullscreenchange', onFsChange);
      document.addEventListener('webkitfullscreenchange', onFsChange);
    })();
  </script>
</body>
</html>
