<!DOCTYPE html>
<html lang="en">
<head>
  <%
    const itemUrl = `${appUrl}/@${dev.handle}/portfolio/${item.slug}`;
    const ld = {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: item.title,
      url: itemUrl,
      image: item.image_url,
      description: item.description.replace(/\s+/g, ' ').slice(0, 300),
      author: { '@type': 'Person', name: dev.name, url: `${appUrl}/@${dev.handle}` },
      sameAs: item.links.filter(l => l.field !== 'drive_url').map(l => l.url),
      video: item.watchUrl ? { '@type': 'VideoObject', name: `${item.title} trailer`, embedUrl: item.embedUrl, url: item.watchUrl, thumbnailUrl: item.image_url, uploadDate: new Date(item.updated_at).toISOString() } : undefined,
      dateModified: new Date(item.updated_at).toISOString(),
      publisher: { '@type': 'Organization', name: appName, url: appUrl },
    };
    // A breadcrumb trail Google can render under the result, matching the
    // visible one below.
    const crumbLd = {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: dev.name, item: `${appUrl}/@${dev.handle}` },
        { '@type': 'ListItem', position: 2, name: 'External Portfolio', item: `${appUrl}/@${dev.handle}#portfolio` },
        { '@type': 'ListItem', position: 3, name: item.title, item: itemUrl },
      ],
    };
  %>
  <%- include('partials/head', {
        title,
        description: item.description.replace(/\s+/g, ' ').trim(),
        canonical: itemUrl, robots: 'index, follow', ogImage: item.image_url, ogType: 'article',
        ogImageAlt: `${item.title} by ${dev.name}`,
        ogArticle: { author: `${appUrl}/@${dev.handle}`, modified: new Date(item.updated_at).toISOString() },
      }) %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
  <script type="application/ld+json"><%- JSON.stringify(crumbLd).replace(/</g, '\\u003c') %></script>
</head>
<body>
  <%- include('../partials/navbar', { appName, scrolled: true }) %>

  <main class="pf-page pj-page">
    <div class="container">
      <a href="/@<%= dev.handle %>#portfolio" class="pj-back" data-back>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"
             stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5"/><polyline points="12 19 5 12 12 5"/></svg>
        Back
      </a>

      <nav class="pj-crumbs" aria-label="Breadcrumb">
        <a href="/@<%= dev.handle %>" class="pj-crumb-dev">
          <span class="pf-avatar pf-avatar--xxs">
            <% if (dev.avatar_url) { %><img src="<%= dev.avatar_url %>" alt="" /><% } else { %><%= dev.name.charAt(0).toUpperCase() %><% } %>
          </span>
          <%= dev.name %>
        </a>
        <span aria-hidden="true">/</span>
        <a href="/@<%= dev.handle %>#portfolio">External Portfolio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= item.title %></span>
      </nav>

      <header class="pj-head">
        <div style="min-width:0;flex:1;">
          <div class="pj-kicker">
            <span class="pf-pill">External project</span>
            <span class="pj-readonly">by <a href="/@<%= dev.handle %>" class="fo-byline">@<%= dev.handle %></a></span>
          </div>
          <h1 class="pj-title"><%= item.title %></h1>
        </div>
        <div class="pf-actions">
          <% if (viewer.isSelf) { %>
            <a href="/developer/portfolio/<%= item.slug %>/edit" class="btn btn-ghost pf-btn pf-btn--sm">Edit in portal</a>
          <% } %>
          <button type="button" class="btn btn-ghost pf-btn pf-btn--sm" data-share="<%= itemUrl %>" data-share-title="<%= item.title %> by <%= dev.name %>">Share</button>
        </div>
      </header>

      <div class="fo-layout">
        <div class="fo-col-media">
          <div class="fo-media">
            <% if (item.embedUrl) { %>
              <iframe src="<%= item.embedUrl %>" title="<%= item.title %> trailer" loading="lazy"
                      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen referrerpolicy="strict-origin-when-cross-origin"
                      sandbox="allow-scripts allow-same-origin allow-presentation allow-popups allow-popups-to-escape-sandbox"></iframe>
            <% } else { %>
              <img src="<%= item.image_url %>" alt="<%= item.title %>" />
            <% } %>
          </div>
        </div>

        <aside class="pf-card fo-aside">
          <% if (item.embedUrl) { %><img class="fo-aside-img" src="<%= item.image_url %>" alt="<%= item.title %>" /><% } %>
          <% if (item.links.length) { %>
            <h2 class="pf-card-title">Get it on</h2>
            <div class="fo-links">
              <% item.links.forEach(l => { let host = ''; try { host = new URL(l.url).hostname.replace(/^www\./, ''); } catch (_) {} %>
                <a class="fo-link fo-link--<%= l.brand %>" href="<%= l.url %>" target="_blank" rel="noopener nofollow ugc">
                  <svg class="fo-link-logo" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><use href="#brand-<%= l.brand %>"></use></svg>
                  <span class="fo-link-text"><%= l.cta %> <%= l.label %><small><%= host %></small></span>
                  <svg class="fo-link-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <p class="pf-muted">No store links have been added for this project.</p>
          <% } %>
          <p class="fo-note">Links open external websites not operated by <%= appName %>.</p>
        </aside>

        <div class="fo-col-desc">
          <h2 class="fo-heading">About this project</h2>
          <p class="fo-desc"><%= item.description %></p>
        </div>
      </div>

      <% if (others.length) { %>
        <section class="pf-section fo-more">
          <div class="pf-section-head">
            <h2 class="pf-section-title">More from <%= dev.name %></h2>
            <a href="/@<%= dev.handle %>#portfolio" class="pf-count">View profile →</a>
          </div>
          <div class="pf-folio-grid">
            <% others.forEach(o => { %>
              <a href="/@<%= dev.handle %>/portfolio/<%= o.slug %>" class="pf-folio">
                <span class="pf-folio-media"><img src="<%= o.image_url %>" alt="<%= o.title %>" loading="lazy" /></span>
                <span class="pf-folio-body"><span class="pf-folio-title"><%= o.title %></span></span>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>
  </main>

  <!-- Store brand marks, referenced by <use> from the buttons above. -->
  <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
    <symbol id="brand-steam" viewBox="0 0 24 24"><path d="M11.979 0C5.678 0 .511 4.86 0 11.021l6.436 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142v-.06c0-2.499 2.028-4.532 4.525-4.532 2.496 0 4.525 2.033 4.525 4.532s-2.029 4.532-4.525 4.532h-.105l-4.076 2.911c0 .052.004.105.004.157 0 1.875-1.515 3.396-3.38 3.396-1.635 0-3.005-1.175-3.315-2.727L.157 15.359C1.541 20.293 6.32 24 11.979 24 18.603 24 24 18.627 24 12S18.603 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.454 1.012zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.253 0-2.265-1.014-2.265-2.265z"/></symbol>
    <symbol id="brand-play" viewBox="0 0 24 24"><path d="M22.018 13.298l-3.919 2.218-3.515-3.493 3.543-3.521 3.891 2.202a1.49 1.49 0 0 1 0 2.594zM1.337.924a1.486 1.486 0 0 0-.112.568v21.017c0 .217.045.419.124.6l11.155-11.087zm12.207 10.065l3.258-3.238L3.45.195a1.466 1.466 0 0 0-.946-.179zm0 2.067L2.544 23.989c.298.036.612-.016.906-.183l13.324-7.54z"/></symbol>
    <symbol id="brand-ios" viewBox="0 0 24 24"><path d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></symbol>
    <symbol id="brand-itch" viewBox="0 0 24 24"><path d="M3.13 1.338C2.08 1.96.02 4.328 0 4.95v1.03c0 1.303 1.22 2.45 2.325 2.45 1.33 0 2.436-1.102 2.436-2.41 0 1.308 1.07 2.41 2.4 2.41 1.328 0 2.362-1.102 2.362-2.41 0 1.308 1.137 2.41 2.466 2.41h.024c1.33 0 2.466-1.102 2.466-2.41 0 1.308 1.034 2.41 2.363 2.41 1.33 0 2.4-1.102 2.4-2.41 0 1.308 1.106 2.41 2.435 2.41C22.78 8.43 24 7.282 24 5.98V4.95c-.02-.622-2.08-2.99-3.13-3.612-3.253-.114-5.508-.134-8.87-.133-3.362 0-7.945.053-8.87.133zm6.376 6.477a2.74 2.74 0 0 1-.468.602c-.5.49-1.19.797-1.943.797a2.786 2.786 0 0 1-1.947-.797 2.774 2.774 0 0 1-.446-.59c-.127.22-.303.412-.486.59a2.788 2.788 0 0 1-1.947.797c-.1 0-.2-.032-.27-.066-.11 1.15-.157 2.25-.174 3.052v.002l-.002 1.55c.02 3.147-.312 10.18 1.36 11.886 2.59.605 7.355.88 12.137.882h.003c4.782-.002 9.546-.277 12.136-.882 1.672-1.705 1.34-8.74 1.36-11.886v-1.55c-.017-.805-.064-1.906-.174-3.055-.07.034-.17.066-.27.066a2.788 2.788 0 0 1-1.947-.798c-.184-.178-.36-.37-.486-.59-.126.22-.264.412-.446.59a2.786 2.786 0 0 1-1.947.798c-.754 0-1.442-.307-1.943-.797a2.774 2.774 0 0 1-.468-.602 2.774 2.774 0 0 1-.463.602 2.79 2.79 0 0 1-1.95.797h-.16a2.79 2.79 0 0 1-1.95-.797 2.771 2.771 0 0 1-.464-.602 2.74 2.74 0 0 1-.468.602 2.786 2.786 0 0 1-1.944.797 2.788 2.788 0 0 1-1.947-.797zm-.9 3.458h.002c.79.002 1.49 0 2.358.953a10.08 10.08 0 0 1 1.023-.048h.007c.375 0 .715.01 1.024.048.87-.953 1.568-.95 2.357-.953.373 0 1.865 0 2.906 2.913l1.118 4.012c.828 2.982-.265 3.05-1.63 3.053-2.023-.075-3.142-1.545-3.142-3.015-1.12.184-2.428.253-3.552.253h-.008c-1.124 0-2.431-.069-3.551-.253 0 1.47-1.12 2.94-3.142 3.015-1.365-.003-2.458-.071-1.63-3.053l1.117-4.012c1.042-2.913 2.534-2.913 2.907-2.913zM12 12.714c-.002.002-2.14 1.964-2.523 2.662l1.38-.056v1.202c0 .056.57.033 1.143.007.573.026 1.142.049 1.142-.007v-1.202l1.38.056c-.382-.698-2.52-2.66-2.52-2.66z"/></symbol>
    <symbol id="brand-drive" viewBox="0 0 24 24"><path d="M7.71 3.5L1.15 15l3.43 5.98L11.14 9.5zm8.58 0h-6.6l6.56 11.5h6.6zM8.31 16.5L4.88 22.5h14.24l3.43-6z"/></symbol>
  </defs></svg>

  <%- include('../partials/footer', { appName }) %>
  <script src="/js/main.js"></script>
  <script src="/js/profile.js" defer></script>
  <script>
    // The href is a real link to the profile, so this page works without JS
    // and for anyone landing here from search. Only when the visitor actually
    // came from another page on this site does Back mean "go back".
    (function () {
      const back = document.querySelector('[data-back]');
      if (!back) return;
      let internal = false;
      try { internal = !!document.referrer && new URL(document.referrer).origin === location.origin; } catch (_) {}
      if (!internal || history.length <= 1) return;
      back.addEventListener('click', function (e) { e.preventDefault(); history.back(); });
    })();
  </script>
</body>
</html>
