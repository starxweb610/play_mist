<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <!-- SEO -->
  <title><%= title %></title>
  <meta name="description" content="Play <%= game.title %> free in your browser — no download required. Powered by <%= appName %>." />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="<%= appUrl %>/play/<%= game.slug %>" />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css" />

  <!-- Favicon -->
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🎮</text></svg>" />
</head>
<body class="play-body">

  <!-- ─── PLAYER BAR ───────────────────────────────────────────────────── -->
  <header class="player-bar">
    <a href="/games/<%= game.slug %>" class="player-back" aria-label="Back to game details">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      <span class="player-back-text">Back</span>
    </a>
    <div class="player-title">
      <span class="logo-icon">🎮</span>
      <span><%= game.title %></span>
    </div>
    <button class="player-fullscreen" id="fullscreenBtn" aria-label="Toggle fullscreen">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8 3H5a2 2 0 00-2 2v3m18 0V5a2 2 0 00-2-2h-3m0 18h3a2 2 0 002-2v-3M3 16v3a2 2 0 002 2h3"/></svg>
      <span class="player-fullscreen-text">Fullscreen</span>
    </button>
  </header>

  <!-- ─── GAME FRAME ───────────────────────────────────────────────────── -->
  <main class="player-stage player-stage--<%= game.orientation %>" id="playerStage">
    <iframe
      id="gameFrame"
      src="<%= playUrl %>"
      title="<%= game.title %>"
      class="player-frame"
      allow="autoplay; fullscreen; gamepad; accelerometer; gyroscope"
      allowfullscreen
      loading="eager">
    </iframe>
  </main>

  <script src="/js/main.js"></script>
  <script>
    (function () {
      const btn = document.getElementById('fullscreenBtn');
      const stage = document.getElementById('playerStage');

      btn.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          (stage.requestFullscreen || stage.webkitRequestFullscreen || stage.msRequestFullscreen).call(stage);
        } else {
          (document.exitFullscreen || document.webkitExitFullscreen || document.msExitFullscreen).call(document);
        }
      });

      document.addEventListener('fullscreenchange', () => {
        stage.classList.toggle('is-fullscreen', !!document.fullscreenElement);
      });
    })();
  </script>
</body>
</html>
