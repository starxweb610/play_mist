<aside class="sidebar" id="sidebar">
  <div class="sidebar-brand">
    <a href="/"><img src="/images/play_logo.png" alt="PlayMist" class="sidebar-brand-logo" /></a>
    <span class="brand-sub">Admin Panel</span>
  </div>

  <nav class="sidebar-nav" aria-label="Admin navigation">
    <div class="nav-group">
      <span class="nav-group-label">Overview</span>
      <a href="/sitehandler/dashboard" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        <span>Dashboard</span>
      </a>
      <a href="/sitehandler/analytics" class="nav-item <%= activePage === 'analytics' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        <span>Analytics</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Content</span>
      <a href="/sitehandler/games" class="nav-item <%= activePage === 'games' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 12h4M8 10v4M15 12h.01M18 12h.01M5 6h14a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2z"/></svg>
        <span>Games</span>
      </a>
      <a href="/sitehandler/genres" class="nav-item <%= activePage === 'genres' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 19a2 2 0 01-2 2H4a2 2 0 01-2-2V5a2 2 0 012-2h5l2 3h9a2 2 0 012 2z"/></svg>
        <span>Genres</span>
      </a>
      <a href="/sitehandler/tags" class="nav-item <%= activePage === 'tags' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82zM7 7h.01"/></svg>
        <span>Tags</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Support</span>
      <a href="/sitehandler/tickets" class="nav-item <%= activePage === 'tickets' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 12V7a2 2 0 00-2-2H6a2 2 0 00-2 2v10a2 2 0 002 2h4m-4-5h8m-8-4h8"/><circle cx="18" cy="18" r="3"/><path d="M21 21l-1.5-1.5"/></svg>
        <span>Tickets</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Developer Portal</span>
      <a href="/sitehandler/developer-submissions" class="nav-item <%= activePage === 'dev-submissions' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
        <span>Submissions</span>
      </a>
      <a href="/sitehandler/developers" class="nav-item <%= activePage === 'developers' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7H4a2 2 0 00-2 2v6a2 2 0 002 2h16a2 2 0 002-2V9a2 2 0 00-2-2z"/><path d="M16 3v4M8 3v4M12 3v4M8 13h.01M12 13h.01M16 13h.01"/></svg>
        <span>Developers</span>
      </a>
      <a href="/sitehandler/guidelines" class="nav-item <%= activePage === 'guidelines' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
        <span>Guidelines</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">Engage</span>
      <a href="/sitehandler/notifications" class="nav-item <%= activePage === 'notifications' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/></svg>
        <span>Notifications</span>
      </a>
    </div>

    <div class="nav-group">
      <span class="nav-group-label">System</span>
      <a href="/sitehandler/users" class="nav-item <%= activePage === 'users' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8z"/></svg>
        <span>Users</span>
      </a>
      <a href="/sitehandler/admins" class="nav-item <%= activePage === 'admins' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8zM23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>
        <span>Admins</span>
      </a>
      <a href="/sitehandler/settings" class="nav-item <%= activePage === 'settings' ? 'active' : '' %>">
        <svg class="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        <span>Settings</span>
      </a>
    </div>
  </nav>

  <div class="sidebar-footer">
    <div class="admin-info">
      <div class="admin-avatar"><%= admin && admin.name ? admin.name.charAt(0).toUpperCase() : 'A' %></div>
      <div class="admin-meta">
        <span class="admin-name"><%= admin ? admin.name : 'Admin' %></span>
        <span class="admin-role"><%= admin ? admin.role : '' %></span>
      </div>
    </div>
    <a href="/sitehandler/logout" class="logout-btn" title="Logout">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/></svg>
    </a>
  </div>
</aside>
