<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'My Profile' }) %>
  <style>
    .profile-hero {
      display: flex;
      gap: 22px;
      align-items: center;
      padding: 22px;
      background: linear-gradient(135deg, var(--accent-soft), transparent 70%), var(--surface);
      border-radius: 14px;
      border: 1px solid var(--line);
      margin-bottom: 22px;
      box-shadow: var(--shadow-card);
    }
    .profile-grid {
      display: grid;
      grid-template-columns: 1fr 1.4fr;
      gap: 18px;
      align-items: start;
    }
    @media (max-width: 800px) { .profile-grid { grid-template-columns: 1fr; } }

    .tabs { display: flex; gap: 4px; margin-bottom: 18px; }
    .tab-btn {
      padding: 7px 14px; border: none; background: none; cursor: pointer;
      font-size: 13px; font-weight: 500; color: var(--ink-3); border-radius: 8px;
      font-family: inherit; transition: background .15s, color .15s;
    }
    .tab-btn:hover  { background: var(--surface-2); color: var(--ink); }
    .tab-btn.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }

    .pf-label { font-size: 12px; font-weight: 500; color: var(--ink-2); display: block; margin-bottom: 6px; }
    .pf-field { margin-bottom: 16px; }
    .pf-field:last-child { margin-bottom: 0; }
    input.pf-input, textarea.pf-input {
      display: block; width: 100%; padding: 9px 12px;
      border: 1px solid var(--line); border-radius: 8px;
      background: var(--surface-2); color: var(--ink);
      font-size: 13px; font-family: inherit; outline: none;
      transition: border-color .15s; box-sizing: border-box;
    }
    input.pf-input:focus, textarea.pf-input:focus { border-color: var(--accent); box-shadow: none; }

    /* ── Avatar upload wrapper ── */
    .avatar-wrap {
      position: relative;
      flex-shrink: 0;
      width: 64px;
      height: 64px;
      overflow: hidden;
      border-radius: 50%;
    }
    .avatar-wrap .avatar.xl {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      height: 100%;
      cursor: pointer;
    }
    .avatar-overlay {
      position: absolute;
      top: 0; left: 0;
      width: 100%; height: 100%;
      border-radius: 50%;
      background: rgba(0,0,0,0.55);
      display: flex;
      align-items: center;
      justify-content: center;
      opacity: 0;
      cursor: pointer;
      transition: opacity .15s;
      color: #fff;
    }
    .avatar-wrap:hover .avatar-overlay { opacity: 1; }
    .avatar-uploading { opacity: 0.5; pointer-events: none; }
    .avatar-error {
      font-size: 11px; color: var(--danger); margin-top: 6px;
      text-align: center; max-width: 64px;
    }
  </style>
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<div class="container-app">
  <%- include('partials/sidebar', { activePage: 'profile' }) %>

  <main class="main-content">
    <header class="topbar">
      <button class="dev-menu-btn" id="devMenuBtn" aria-label="Open navigation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title">My Profile</span>
    </header>

    <div class="page-content scroll">
      <%- include('partials/flash') %>

      <% if (typeof errors !== 'undefined' && errors && errors.length > 0) { %>
        <div class="flash flash-error" style="margin-bottom:16px;">
          <% if (errors.length === 1) { %><%= errors[0] %>
          <% } else { %><ul style="margin:0;padding-left:18px;"><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul><% } %>
        </div>
      <% } %>

      <!-- Profile hero -->
      <div class="profile-hero">
        <div style="display:flex;flex-direction:column;align-items:center;gap:4px;">
          <div class="avatar-wrap" id="avatarWrap">
            <div class="avatar xl" id="profileAvatar" style="background:linear-gradient(135deg,var(--accent),var(--accent-2));color:var(--accent-ink);">
              <% if (devProfile.avatar_url) { %>
                <img src="<%= devProfile.avatar_url %>" alt="<%= devProfile.name %>">
              <% } else { %>
                <%= devProfile.name.charAt(0).toUpperCase() %>
              <% } %>
            </div>
            <label class="avatar-overlay" for="avatarInput" title="Change photo">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
                <circle cx="12" cy="13" r="4"/>
              </svg>
            </label>
            <input type="file" id="avatarInput" accept="image/jpeg,image/png,image/webp" style="display:none;">
          </div>
          <div class="avatar-error" id="avatarError" style="display:none;"></div>
        </div>
        <div>
          <h1 style="margin:0;font-size:22px;font-weight:700;letter-spacing:-0.02em;color:var(--ink);"><%= devProfile.name %></h1>
          <div style="color:var(--ink-3);font-size:13px;margin-top:3px;"><%= devProfile.email %></div>
          <div style="margin-top:10px;display:flex;gap:8px;flex-wrap:wrap;">
            <span class="badge-pending" style="font-size:11px;padding:3px 10px;"><span class="badge-dot"></span><%= devProfile.studio_name %></span>
            <span style="font-size:12px;color:var(--ink-3);display:flex;align-items:center;gap:5px;">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" width="12" height="12"><path d="M21 10c0 7-9 13-9 13S3 17 3 10a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
              <%= devProfile.country %>
            </span>
          </div>
        </div>
      </div>

      <div class="profile-grid">
        <!-- Left: forms -->
        <div class="card" style="padding:22px;">
          <div class="tabs">
            <button class="tab-btn <%= (typeof activeTab === 'undefined' || activeTab === 'profile') ? 'active' : '' %>" data-tab="profile-tab">Profile</button>
            <button class="tab-btn <%= (typeof activeTab !== 'undefined' && activeTab === 'security') ? 'active' : '' %>" data-tab="security-tab">Security</button>
          </div>

          <!-- Profile tab -->
          <div id="profile-tab" style="display:<%= (typeof activeTab === 'undefined' || activeTab === 'profile') ? 'block' : 'none' %>;">
            <form method="POST" action="/developer/profile">
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="pf-field">
                  <label class="pf-label" for="pf-name">Full Name *</label>
                  <input type="text" id="pf-name" name="name" class="pf-input" required value="<%= devProfile.name || '' %>" />
                </div>
                <div class="pf-field">
                  <label class="pf-label" for="pf-studio">Studio Name *</label>
                  <input type="text" id="pf-studio" name="studio_name" class="pf-input" required value="<%= devProfile.studio_name || '' %>" />
                </div>
              </div>
              <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                <div class="pf-field">
                  <label class="pf-label" for="pf-country">Country *</label>
                  <input type="text" id="pf-country" name="country" class="pf-input" required value="<%= devProfile.country || '' %>" />
                </div>
                <div class="pf-field">
                  <label class="pf-label" for="pf-phone">Phone <span style="color:var(--ink-3);font-weight:400;">(optional)</span></label>
                  <input type="tel" id="pf-phone" name="phone" class="pf-input" value="<%= devProfile.phone || '' %>" />
                </div>
              </div>
              <div class="pf-field">
                <label class="pf-label" for="pf-bio">Bio <span style="color:var(--ink-3);font-weight:400;">(optional)</span></label>
                <textarea id="pf-bio" name="bio" rows="3" class="pf-input" style="resize:vertical;" placeholder="Tell other developers about yourself and your games…"><%= devProfile.bio || '' %></textarea>
              </div>
              <button type="submit" class="btn primary sm">Save Changes</button>
            </form>
          </div>

          <!-- Security tab -->
          <div id="security-tab" style="display:<%= (typeof activeTab !== 'undefined' && activeTab === 'security') ? 'block' : 'none' %>;">
            <form method="POST" action="/developer/profile/password">
              <div class="pf-field">
                <label class="pf-label" for="cur-pw">Current Password</label>
                <input type="password" id="cur-pw" name="current_password" class="pf-input" required autocomplete="current-password" />
              </div>
              <div class="pf-field">
                <label class="pf-label" for="new-pw">New Password</label>
                <input type="password" id="new-pw" name="new_password" class="pf-input" required minlength="8" autocomplete="new-password" placeholder="Min 8 characters" />
              </div>
              <div class="pf-field">
                <label class="pf-label" for="conf-pw">Confirm New Password</label>
                <input type="password" id="conf-pw" name="confirm_password" class="pf-input" required autocomplete="new-password" placeholder="Repeat password" />
              </div>
              <button type="submit" class="btn primary sm">Change Password</button>
            </form>
          </div>
        </div>

        <!-- Right: account info -->
        <div class="card" style="padding:22px;">
          <h3 style="margin:0 0 18px;font-size:15px;font-weight:600;color:var(--ink);">Account Info</h3>

          <div style="padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--line);">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--ink-4);font-weight:600;margin-bottom:10px;">Details</div>
            <ul class="meta-list" style="margin:0;">
              <li>
                <span class="meta-key">Email</span>
                <span class="meta-val"><%= devProfile.email %></span>
              </li>
              <li>
                <span class="meta-key">Studio</span>
                <span class="meta-val"><%= devProfile.studio_name %></span>
              </li>
              <li>
                <span class="meta-key">Country</span>
                <span class="meta-val"><%= devProfile.country %></span>
              </li>
              <% if (devProfile.phone) { %>
              <li>
                <span class="meta-key">Phone</span>
                <span class="meta-val"><%= devProfile.phone %></span>
              </li>
              <% } %>
              <li>
                <span class="meta-key">Member since</span>
                <span class="meta-val"><%= devProfile.created_at ? new Date(devProfile.created_at).toLocaleDateString('en-US',{month:'long',year:'numeric'}) : 'N/A' %></span>
              </li>
            </ul>
          </div>

          <% if (devProfile.bio) { %>
          <div style="padding-bottom:16px;margin-bottom:16px;border-bottom:1px solid var(--line);">
            <div style="font-size:11px;text-transform:uppercase;letter-spacing:0.06em;color:var(--ink-4);font-weight:600;margin-bottom:8px;">About</div>
            <p style="font-size:13px;color:var(--ink-2);line-height:1.6;margin:0;"><%= devProfile.bio %></p>
          </div>
          <% } %>
        </div>
      </div>
    </div>
  </main>
</div>

<script>
  // ── Tab switching ────────────────────────────────────────────────────────────
  document.querySelectorAll('[data-tab]').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('[data-tab]').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('[id$="-tab"]').forEach(t => t.style.display = 'none');
      btn.classList.add('active');
      document.getElementById(btn.dataset.tab).style.display = 'block';
    });
  });

  // ── Avatar upload ────────────────────────────────────────────────────────────
  document.getElementById('avatarInput').addEventListener('change', async function () {
    const file = this.files[0];
    if (!file) return;

    const wrap    = document.getElementById('avatarWrap');
    const avatar  = document.getElementById('profileAvatar');
    const errorEl = document.getElementById('avatarError');

    errorEl.style.display = 'none';
    avatar.classList.add('avatar-uploading');

    const formData = new FormData();
    formData.append('avatar', file);

    try {
      const res  = await fetch('/developer/profile/avatar', { method: 'POST', body: formData });
      const data = await res.json();

      if (!res.ok) {
        errorEl.textContent   = data.error || 'Upload failed.';
        errorEl.style.display = 'block';
        return;
      }

      // Update hero avatar
      avatar.innerHTML = `<img src="${data.avatar_url}" alt="Profile photo">`;

      // Update sidebar avatar tile
      const sidebarAvatar = document.querySelector('.user-tile .avatar');
      if (sidebarAvatar) sidebarAvatar.innerHTML = `<img src="${data.avatar_url}" alt="">`;

    } catch (_) {
      errorEl.textContent   = 'Upload failed. Please try again.';
      errorEl.style.display = 'block';
    } finally {
      avatar.classList.remove('avatar-uploading');
      this.value = '';
    }
  });
</script>
</body>
</html>
