<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" /></head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;margin-bottom:24px;">
      <div>
        <h2 class="page-heading">Push Notifications</h2>
        <p class="page-subheading"><%= tokenCount.toLocaleString() %> registered device<%= tokenCount !== 1 ? 's' : '' %></p>
      </div>
    </div>

    <!-- ── Compose & Send ────────────────────────────────────────────── -->
    <div class="card" style="margin-bottom:28px;">
      <div class="card-header">
        <h3 class="card-title">
          <svg style="width:16px;height:16px;vertical-align:-3px;margin-right:6px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/>
          </svg>
          Send Broadcast Notification
        </h3>
      </div>
      <div class="card-body">
        <form method="POST" action="/sitehandler/notifications/send">
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:16px;">
            <div class="form-group" style="margin:0;">
              <label class="form-label">Title <span style="color:#e05c5c">*</span></label>
              <input type="text" name="title" class="form-control" maxlength="100" placeholder="e.g. New game just dropped!" required />
            </div>
            <div class="form-group" style="margin:0;">
              <label class="form-label">Image URL <span style="opacity:.6;font-weight:400;">(optional)</span></label>
              <input type="url" name="image_url" class="form-control" placeholder="https://…/image.jpg" />
            </div>
          </div>
          <div class="form-group" style="margin-bottom:16px;">
            <label class="form-label">Message <span style="color:#e05c5c">*</span></label>
            <textarea name="body" class="form-control" rows="3" maxlength="300" placeholder="Tell users what's new…" required style="resize:vertical;"></textarea>
          </div>
          <div style="display:flex;align-items:center;gap:14px;flex-wrap:wrap;">
            <button type="submit" class="btn-admin-primary" onclick="return confirm('Send this notification to ALL users?')">
              <svg style="width:13px;height:13px;vertical-align:-2px;margin-right:5px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                <line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/>
              </svg>
              Send to all users
            </button>
            <span style="font-size:0.82rem;opacity:.65;">This will push to all <%= tokenCount.toLocaleString() %> registered device<%= tokenCount !== 1 ? 's' : '' %>.</span>
          </div>
        </form>
      </div>
    </div>

    <!-- ── History ───────────────────────────────────────────────────── -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Notification History</h3>
        <span class="admin-badge"><%= notifications.length %></span>
      </div>
      <div class="card-body" style="padding:0;">
        <% if (notifications.length === 0) { %>
          <div style="text-align:center;padding:48px 24px;opacity:.5;">
            <svg style="width:36px;height:36px;margin-bottom:10px;display:block;margin-inline:auto;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9M13.73 21a2 2 0 01-3.46 0"/>
            </svg>
            No notifications sent yet.
          </div>
        <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Title / Message</th>
                <th>Type</th>
                <th>Sent by</th>
                <th>Recipients</th>
                <th>Date</th>
              </tr>
            </thead>
            <tbody>
              <% notifications.forEach(function(n) { %>
                <tr>
                  <td>
                    <div style="font-weight:600;font-size:.9rem;margin-bottom:3px;"><%= n.title %></div>
                    <div style="font-size:.8rem;opacity:.65;max-width:360px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"><%= n.body %></div>
                    <% if (n.game_title) { %>
                      <span style="display:inline-block;margin-top:4px;font-size:.72rem;padding:1px 8px;border-radius:4px;background:rgba(155,125,255,.15);color:#9B7DFF;">Game: <%= n.game_title %></span>
                    <% } %>
                  </td>
                  <td>
                    <% if (n.type === 'new_game') { %>
                      <span class="status-badge status-badge--active">New Game</span>
                    <% } else { %>
                      <span class="status-badge status-badge--pending">Custom</span>
                    <% } %>
                  </td>
                  <td style="font-size:.85rem;opacity:.7;"><%= n.sent_by_name || '—' %></td>
                  <td style="font-size:.85rem;font-weight:600;"><%= (n.total_recipients || 0).toLocaleString() %></td>
                  <td style="font-size:.8rem;opacity:.65;white-space:nowrap;">
                    <%= new Date(n.sent_at).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short' }) %>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

  </main>
</div>
<script src="/sitehandler/js/admin.js"></script>
</body>
</html>
