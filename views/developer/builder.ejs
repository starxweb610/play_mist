<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Game Builder' }) %>
  <style>
    .gb-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; }
    .gb-card {
      background: var(--surface);
      border: 1px solid var(--line);
      border-radius: var(--border-radius);
      padding: 20px;
      display: flex; flex-direction: column; gap: 12px;
      text-decoration: none;
      box-shadow: var(--shadow-card);
      transition: border-color .15s, transform .1s, box-shadow .15s;
    }
    .gb-card:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: var(--shadow-modal); }
    .gb-card-head { display: flex; align-items: flex-start; gap: 12px; }
    .gb-icon {
      width: 40px; height: 40px; border-radius: 10px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 17px; font-weight: 800; color: #fff;
    }
    .gb-icon.coral  { background: linear-gradient(135deg,#ff6b6b,#ee5a24); }
    .gb-icon.violet { background: linear-gradient(135deg,#a78bfa,#7c3aed); }
    .gb-icon.teal   { background: linear-gradient(135deg,#2dd073,#0ea5e9); }
    .gb-icon.amber  { background: linear-gradient(135deg,#ffb547,#f97316); }
    .gb-icon.lime   { background: linear-gradient(135deg,#B5FF6B,#7EE64A); color: #1a1d24; }

    .gb-name { font-size: 15px; font-weight: 700; color: var(--ink); margin: 0 0 2px; line-height: 1.3; }
    .gb-desc {
      font-size: 12px; color: var(--ink-3); margin: 0; line-height: 1.45;
      display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
    }
    .gb-foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; }
    .gb-pill {
      display: inline-flex; align-items: center; gap: 5px;
      font-size: 11px; font-weight: 600; padding: 3px 9px; border-radius: 99px;
    }
    .gb-pill.built  { color: var(--accent); background: var(--accent-soft); }
    .gb-pill.empty  { color: var(--ink-3); background: var(--surface-3); }
    .gb-cta { font-size: 12px; font-weight: 600; color: var(--ink-2); }

    .gb-empty {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--border-radius); padding: 48px 28px; text-align: center;
      max-width: 560px; margin: 0 auto; box-shadow: var(--shadow-card);
    }
    .gb-empty-icon { font-size: 40px; line-height: 1; margin-bottom: 16px; }
    .gb-empty h2 { margin: 0 0 8px; font-size: 18px; font-weight: 700; color: var(--ink); }
    .gb-empty p { margin: 0 auto 22px; font-size: 13px; color: var(--ink-3); line-height: 1.6; max-width: 420px; }

    .gb-intro {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--border-radius); padding: 16px 18px; margin-bottom: 22px;
      display: flex; gap: 14px; align-items: flex-start;
    }
    .gb-intro svg { flex-shrink: 0; color: var(--accent); margin-top: 2px; }
    .gb-intro p { margin: 0; font-size: 12.5px; color: var(--ink-2); line-height: 1.6; }
  </style>
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<div class="container-app">
  <%- include('partials/sidebar', { activePage: 'builder' }) %>

  <main class="main-content">
    <header class="topbar">
      <button class="dev-menu-btn" id="devMenuBtn" aria-label="Open navigation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title">Game Builder</span>
      <div class="top-actions">
        <a href="/developer/projects" class="btn sm">Manage projects</a>
      </div>
    </header>

    <div class="page-content scroll">
      <%- include('partials/flash') %>

      <div class="page-h" style="margin-bottom:20px;">
        <div>
          <h1 style="margin:0;font-size:20px;font-weight:700;color:var(--ink);">Build in your browser</h1>
          <div style="font-size:13px;color:var(--ink-3);margin-top:3px;">
            Pick a project, start from a template, and edit, run and debug it right here.
          </div>
        </div>
      </div>

      <% if (projects && projects.length > 0) { %>
        <div class="gb-intro">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/>
          </svg>
          <p>
            Each project gets its own workspace. Choosing a template unpacks a starter game you can
            edit file by file — <strong>index.html</strong> is always the entry point the Run button opens.
          </p>
        </div>

        <div class="gb-grid">
          <% projects.forEach((project, i) => {
               const icons = ['coral','violet','teal','amber','lime'];
               const icon  = icons[i % icons.length];
               const built = !!project.workspace_id; %>
            <a href="/developer/builder/<%= project.slug %>" class="gb-card">
              <div class="gb-card-head">
                <div class="gb-icon <%= icon %>"><%= project.name.charAt(0).toUpperCase() %></div>
                <div style="flex:1;min-width:0;">
                  <h4 class="gb-name"><%= project.name %></h4>
                  <% if (project.description) { %>
                    <p class="gb-desc"><%= project.description %></p>
                  <% } else { %>
                    <p class="gb-desc" style="opacity:.6;">No description</p>
                  <% } %>
                </div>
              </div>

              <div class="gb-foot">
                <% if (built) { %>
                  <span class="gb-pill built">
                    <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3">
                      <polyline points="20 6 9 17 4 12"/>
                    </svg>
                    <%= project.template_name || 'Workspace ready' %>
                  </span>
                  <span class="gb-cta">Open →</span>
                <% } else { %>
                  <span class="gb-pill empty">No template yet</span>
                  <span class="gb-cta">Set up →</span>
                <% } %>
              </div>
            </a>
          <% }) %>
        </div>
      <% } else { %>
        <div class="gb-empty">
          <div class="gb-empty-icon">🎮</div>
          <h2>Create a project first</h2>
          <p>
            The Game Builder works inside a project, so your files, tasks, docs and storyboards
            all live together. Create one and it will show up here ready to link to a template.
          </p>
          <a href="/developer/projects" class="btn primary">Create a project</a>
        </div>
      <% } %>
    </div>
  </main>
</div>
</body>
</html>
