<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Choose a template' }) %>
  <style>
    .tp-wrap { max-width: 900px; }

    .tp-step { display: flex; align-items: center; gap: 10px; margin-bottom: 18px; }
    .tp-step-dot {
      width: 22px; height: 22px; border-radius: 50%; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px; font-weight: 700;
      background: var(--accent); color: var(--accent-ink);
    }
    .tp-step-dot.idle { background: var(--surface-3); color: var(--ink-3); }
    .tp-step-label { font-size: 14px; font-weight: 700; color: var(--ink); }
    .tp-step-label.idle { color: var(--ink-3); }

    .tp-cats { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 30px; }
    .tp-cat {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: 10px; padding: 12px 16px; cursor: pointer;
      color: var(--ink-2); font-size: 13px; font-weight: 600;
      display: flex; flex-direction: column; gap: 3px; min-width: 132px;
      transition: border-color .15s, background .15s, transform .1s;
      text-align: left;
    }
    .tp-cat:hover { border-color: var(--line-strong); transform: translateY(-1px); }
    .tp-cat.active { border-color: var(--accent); background: var(--accent-soft); color: var(--ink); }
    .tp-cat small { font-size: 11px; font-weight: 500; color: var(--ink-3); }
    .tp-cat.active small { color: var(--ink-2); }

    .tp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(258px, 1fr)); gap: 14px; }
    .tp-card {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--border-radius); padding: 18px;
      display: flex; flex-direction: column; gap: 10px; cursor: pointer;
      text-align: left; color: inherit; font: inherit;
      transition: border-color .15s, transform .1s, box-shadow .15s;
    }
    .tp-card:hover { border-color: var(--line-strong); transform: translateY(-2px); box-shadow: var(--shadow-modal); }
    .tp-card.active { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent) inset; }
    .tp-card-name { font-size: 14px; font-weight: 700; color: var(--ink); margin: 0; }
    .tp-card-desc { font-size: 12px; color: var(--ink-3); margin: 0; line-height: 1.5; flex: 1; }
    .tp-card-meta { font-size: 11px; color: var(--ink-4); display: flex; gap: 12px; }

    .tp-actions {
      position: sticky; bottom: 0; margin-top: 26px;
      background: linear-gradient(to top, var(--bg) 62%, transparent);
      padding: 18px 0 6px; display: flex; align-items: center; gap: 12px; flex-wrap: wrap;
    }
    .tp-chosen { font-size: 12.5px; color: var(--ink-3); flex: 1; min-width: 180px; }
    .tp-chosen b { color: var(--ink); }

    .tp-empty {
      background: var(--surface); border: 1px solid var(--line);
      border-radius: var(--border-radius); padding: 44px 26px; text-align: center;
    }
    .tp-empty-icon { font-size: 36px; margin-bottom: 14px; }
    .tp-empty h2 { margin: 0 0 8px; font-size: 17px; font-weight: 700; color: var(--ink); }
    .tp-empty p { margin: 0; font-size: 13px; color: var(--ink-3); line-height: 1.6; }

    .tp-hidden { display: none; }
  </style>
  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<div class="container-app">
  <%- include('partials/sidebar', { activePage: 'builder' }) %>

  <main class="main-content">
    <header class="topbar">
      <button class="dev-menu-btn" id="devMenuBtn" aria-label="Open navigation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title"><%= project.name %></span>
      <div class="top-actions">
        <a href="/developer/builder" class="btn sm">All projects</a>
      </div>
    </header>

    <div class="page-content scroll">
      <%- include('partials/flash') %>

      <div class="tp-wrap">
        <div class="page-h" style="margin-bottom:24px;">
          <div>
            <h1 style="margin:0;font-size:20px;font-weight:700;color:var(--ink);">Choose a starting template</h1>
            <div style="font-size:13px;color:var(--ink-3);margin-top:3px;">
              This unpacks a starter game into <strong><%= project.name %></strong>. You can edit every file afterwards.
            </div>
          </div>
        </div>

        <% if (!categories.length) { %>
          <div class="tp-empty">
            <div class="tp-empty-icon">📦</div>
            <h2>No templates available yet</h2>
            <p>
              The Play Mist team hasn’t published any builder templates yet.<br />
              Check back soon — your project is saved and ready.
            </p>
          </div>
        <% } else { %>
          <form action="/developer/builder/<%= project.slug %>/template" method="POST" id="templateForm">
            <input type="hidden" name="template_id" id="templateId" value="" />

            <div class="tp-step">
              <span class="tp-step-dot">1</span>
              <span class="tp-step-label">Pick a category</span>
            </div>

            <div class="tp-cats" id="catRow">
              <% categories.forEach((c, i) => { %>
                <button type="button" class="tp-cat <%= i === 0 ? 'active' : '' %>" data-category="<%= c.id %>">
                  <span><%= c.name %></span>
                  <small><%= c.template_count %> template<%= c.template_count === 1 ? '' : 's' %></small>
                </button>
              <% }) %>
            </div>

            <div class="tp-step">
              <span class="tp-step-dot idle" id="step2Dot">2</span>
              <span class="tp-step-label idle" id="step2Label">Pick a template</span>
            </div>

            <div class="tp-grid" id="tplGrid">
              <% templates.forEach((t, i) => { %>
                <button type="button"
                        class="tp-card <%= t.category_id === categories[0].id ? '' : 'tp-hidden' %>"
                        data-template="<%= t.id %>"
                        data-category="<%= t.category_id %>"
                        data-name="<%= t.name %>">
                  <h3 class="tp-card-name"><%= t.name %></h3>
                  <p class="tp-card-desc"><%= t.description || 'A starter project you can edit and run right away.' %></p>
                  <div class="tp-card-meta">
                    <span><%= t.file_count %> files</span>
                    <span><%= (t.size_bytes / 1024).toFixed(0) %> KB</span>
                  </div>
                </button>
              <% }) %>
            </div>

            <div class="tp-actions">
              <div class="tp-chosen" id="chosen">Select a template to continue.</div>
              <a href="/developer/builder" class="btn">Cancel</a>
              <button type="submit" class="btn primary" id="submitBtn" disabled>Create workspace</button>
            </div>
          </form>
        <% } %>
      </div>
    </div>
  </main>
</div>

<script>
  (function () {
    var catRow    = document.getElementById('catRow');
    var grid      = document.getElementById('tplGrid');
    var hidden    = document.getElementById('templateId');
    var submitBtn = document.getElementById('submitBtn');
    var chosen    = document.getElementById('chosen');
    var step2Dot  = document.getElementById('step2Dot');
    var step2Lbl  = document.getElementById('step2Label');
    var form      = document.getElementById('templateForm');
    if (!catRow || !grid) return;

    function clearSelection() {
      hidden.value = '';
      submitBtn.disabled = true;
      chosen.textContent = 'Select a template to continue.';
      step2Dot.classList.add('idle');
      step2Lbl.classList.add('idle');
      grid.querySelectorAll('.tp-card.active').forEach(function (el) { el.classList.remove('active'); });
    }

    catRow.addEventListener('click', function (e) {
      var btn = e.target.closest('.tp-cat');
      if (!btn) return;
      catRow.querySelectorAll('.tp-cat').forEach(function (el) { el.classList.remove('active'); });
      btn.classList.add('active');

      var categoryId = btn.getAttribute('data-category');
      grid.querySelectorAll('.tp-card').forEach(function (card) {
        card.classList.toggle('tp-hidden', card.getAttribute('data-category') !== categoryId);
      });
      // Switching category hides whatever was picked, so the choice has to go
      // with it — otherwise the form would submit an invisible template.
      clearSelection();
    });

    grid.addEventListener('click', function (e) {
      var card = e.target.closest('.tp-card');
      if (!card) return;
      grid.querySelectorAll('.tp-card').forEach(function (el) { el.classList.remove('active'); });
      card.classList.add('active');

      hidden.value = card.getAttribute('data-template');
      submitBtn.disabled = false;
      chosen.innerHTML = 'Starting from <b></b>';
      chosen.querySelector('b').textContent = card.getAttribute('data-name');
      step2Dot.classList.remove('idle');
      step2Lbl.classList.remove('idle');
    });

    // Extraction takes a moment; a second submit would race the first and hit
    // the "already has a template" guard with a confusing error.
    form.addEventListener('submit', function () {
      submitBtn.disabled = true;
      submitBtn.textContent = 'Setting up…';
    });
  })();
</script>
</body>
</html>
