<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: project.name + ' — Builder' }) %>
  <link rel="stylesheet" href="/css/builder.css?v=<%= assetV %>" />
  <!-- CodeMirror 5: a single UMD bundle with no build step, and the only
       mainstream editor that stays usable on a phone keyboard. -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.css" />
  <link rel="icon" href="/favicon.ico" />
</head>
<body>

<div class="ide">
  <!-- ── Top bar ───────────────────────────────────────────────────── -->
  <header class="ide-topbar">
    <a href="/developer/builder" class="exp-btn" title="Back to Game Builder" aria-label="Back to Game Builder">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <line x1="19" y1="12" x2="5" y2="12"/><polyline points="12 19 5 12 12 5"/>
      </svg>
    </a>

    <div class="ide-title">
      <b><%= project.name %></b>
      <% if (workspace.template_name) { %><span><%= workspace.template_name %></span><% } %>
    </div>

    <span class="ide-status" id="ideStatus"></span>

    <div class="ide-top-actions">
      <button class="btn sm" id="saveBtn" title="Save (Ctrl+S)">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
          <polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/>
        </svg>
        <span class="label-lg">Save</span>
      </button>

      <button class="btn primary sm" id="runBtn" title="Run the game">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        <span class="label-lg">Run</span>
      </button>

      <div style="position:relative">
        <button class="exp-btn" id="moreBtn" title="More actions" aria-label="More actions">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="5" r="1"/><circle cx="12" cy="12" r="1"/><circle cx="12" cy="19" r="1"/>
          </svg>
        </button>
        <div class="ctx-menu" id="moreMenu" style="right:0;left:auto;top:38px;position:absolute">
          <a class="ctx-item" href="/developer/builder/<%= project.slug %>/export">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Download project (.zip)
          </a>
          <a class="ctx-item" href="/developer/projects/<%= project.slug %>">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            </svg>
            Open project board
          </a>
          <div class="ctx-sep"></div>
          <button type="button" class="ctx-item danger" id="resetBtn">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
            </svg>
            Change template…
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- ── Body ──────────────────────────────────────────────────────── -->
  <div class="ide-body" id="ideBody" data-pane="editor">

    <!-- Explorer -->
    <aside class="ide-explorer" id="explorer">
      <div class="exp-head">
        <h2>Files</h2>
        <button class="exp-btn" id="newFileBtn" title="New file" aria-label="New file">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
            <line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
          </svg>
        </button>
        <button class="exp-btn" id="newFolderBtn" title="New folder" aria-label="New folder">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
            <line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/>
          </svg>
        </button>
        <button class="exp-btn" id="uploadBtn" title="Upload an image" aria-label="Upload an image">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>
          </svg>
        </button>
        <input type="file" id="uploadInput" accept="image/png,image/jpeg,image/webp,image/gif,image/svg+xml,image/x-icon" hidden />
      </div>

      <div class="exp-tree scroll" id="tree"></div>

      <div class="exp-foot">
        <span id="usageFiles">— files</span>
        <span id="usageSize">—</span>
      </div>
    </aside>

    <!-- Editor -->
    <section class="ide-editor" id="editorPane">
      <div class="tabbar" id="tabbar"></div>
      <div class="editor-host" id="editorHost">
        <div class="editor-empty" id="editorEmpty">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
          </svg>
          <p>Double-tap a file in the explorer to open it. Press <kbd>Ctrl</kbd>+<kbd>S</kbd> to save.</p>
        </div>
        <div class="editor-image" id="editorImage">
          <img id="editorImageEl" alt="" />
          <div class="meta" id="editorImageMeta"></div>
        </div>
      </div>
    </section>

    <!-- Preview + console -->
    <section class="ide-preview" id="previewPane">
      <div class="prev-head">
        <h2>Preview</h2>
        <button class="exp-btn" id="reloadBtn" title="Reload preview" aria-label="Reload preview">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="23 4 23 10 17 10"/><polyline points="1 20 1 14 7 14"/>
            <path d="M3.51 9a9 9 0 0 1 14.85-3.36L23 10M1 14l4.64 4.36A9 9 0 0 0 20.49 15"/>
          </svg>
        </button>
        <button class="exp-btn" id="popOutBtn" title="Open preview in a new tab" aria-label="Open preview in a new tab">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
            <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
          </svg>
        </button>
        <button class="exp-btn" id="closePreviewBtn" title="Close preview" aria-label="Close preview">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>

      <div class="prev-stage" id="previewStage">
        <div class="prev-idle" id="previewIdle">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <polygon points="5 3 19 12 5 21 5 3"/>
          </svg>
          <p>Press <strong>Run</strong> to launch your game from <code>index.html</code>.</p>
        </div>
        <!-- The frame is created by JS so its sandbox attributes and src are
             set together, and a stale document is never left behind. -->
      </div>

      <div class="ide-console" id="console">
        <div class="console-head" id="consoleHead">
          <h2>Console</h2>
          <span class="console-count" id="consoleCount">0</span>
          <span class="spacer"></span>
          <button class="exp-btn" id="clearConsoleBtn" title="Clear console" aria-label="Clear console">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6"/>
            </svg>
          </button>
          <span class="console-caret">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
          </span>
        </div>
        <div class="console-body scroll" id="consoleBody">
          <div class="console-empty">Console output from your game appears here while it runs.</div>
        </div>
      </div>
    </section>
  </div>

  <!-- ── Mobile pane switcher ──────────────────────────────────────── -->
  <nav class="ide-mobile-bar" id="mobileBar">
    <button type="button" data-pane="files">
      <span class="mb-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
        </svg>
        Files
      </span>
    </button>
    <button type="button" data-pane="editor" class="active">
      <span class="mb-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>
        </svg>
        Editor
      </span>
    </button>
    <button type="button" data-pane="preview">
      <span class="mb-wrap">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polygon points="5 3 19 12 5 21 5 3"/>
        </svg>
        Run
        <span class="mb-badge" id="mobileErrBadge" hidden>0</span>
      </span>
    </button>
  </nav>
</div>

<!-- ── Explorer context menu ──────────────────────────────────────────── -->
<div class="ctx-menu" id="ctxMenu" role="menu">
  <button type="button" class="ctx-item" data-action="open">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
    </svg>
    Open
  </button>
  <button type="button" class="ctx-item" data-action="new-file">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/>
      <line x1="12" y1="18" x2="12" y2="12"/><line x1="9" y1="15" x2="15" y2="15"/>
    </svg>
    New file here
  </button>
  <button type="button" class="ctx-item" data-action="new-folder">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
      <line x1="12" y1="11" x2="12" y2="17"/><line x1="9" y1="14" x2="15" y2="14"/>
    </svg>
    New folder here
  </button>
  <div class="ctx-sep"></div>
  <button type="button" class="ctx-item" data-action="rename">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
      <path d="M18.5 2.5a2.12 2.12 0 0 1 3 3L12 15l-4 1 1-4z"/>
    </svg>
    Rename…
  </button>
  <button type="button" class="ctx-item danger" data-action="delete">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
    </svg>
    Delete
  </button>
</div>

<!-- ── Prompt dialog (replaces window.prompt — unusable on mobile) ────── -->
<div class="ide-dialog-scrim" id="dialogScrim">
  <div class="ide-dialog" role="dialog" aria-modal="true" aria-labelledby="dialogTitle">
    <h3 id="dialogTitle">Name</h3>
    <p id="dialogHint"></p>
    <input type="text" id="dialogInput" autocomplete="off" autocapitalize="off" autocorrect="off" spellcheck="false" />
    <p class="ide-dialog-error" id="dialogError"></p>
    <div class="ide-dialog-actions">
      <button type="button" class="btn sm" id="dialogCancel">Cancel</button>
      <button type="button" class="btn primary sm" id="dialogConfirm">Confirm</button>
    </div>
  </div>
</div>

<!-- ── Change-template form (posted from the dialog) ──────────────────── -->
<form action="/developer/builder/<%= project.slug %>/reset" method="POST" id="resetForm" hidden>
  <input type="hidden" name="confirm_name" id="resetConfirmName" />
</form>

<div class="ide-toast-host" id="toastHost"></div>

<script>
  // Everything the IDE needs to talk to the server, rendered once.
  window.PM_BUILDER = {
    projectSlug: <%- JSON.stringify(project.slug) %>,
    projectName: <%- JSON.stringify(project.name) %>,
    base: <%- JSON.stringify('/developer/builder/' + project.slug) %>,
    tree: <%- JSON.stringify(tree) %>,
    usage: <%- JSON.stringify(usage) %>,
    limits: <%- JSON.stringify(limits) %>
  };
</script>

<!-- CodeMirror core, then the modes and addons it needs. htmlmixed depends on
     xml + javascript + css, so those load first. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/codemirror.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/xml/xml.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/javascript/javascript.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/css/css.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/htmlmixed/htmlmixed.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/mode/markdown/markdown.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closebrackets.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/closetag.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/edit/matchbrackets.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/codemirror/5.65.16/addon/selection/active-line.min.js"></script>

<script src="/js/developer-builder.js?v=<%= assetV %>"></script>
</body>
</html>
