  <meta charset="UTF-8" />
  <%- include('../../partials/analytics') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= title %></title>
  <meta name="description" content="<%= description %>" />
  <meta name="robots" content="<%= robots %>" />
  <% if (canonical) { %><link rel="canonical" href="<%= canonical %>" /><% } %>

  <meta property="og:title" content="<%= title %>" />
  <meta property="og:description" content="<%= description %>" />
  <% if (canonical) { %><meta property="og:url" content="<%= canonical %>" /><% } %>
  <meta property="og:type" content="<%= ogType %>" />
  <meta property="og:image" content="<%= ogImage || appUrl + '/images/og-default.png' %>" />
  <meta property="og:site_name" content="<%= appName %>" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= title %>" />
  <meta name="twitter:description" content="<%= description %>" />
  <meta name="twitter:image" content="<%= ogImage || appUrl + '/images/og-default.png' %>" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/style.css" />
  <link rel="stylesheet" href="/css/profile.css" />
  <link rel="icon" href="/favicon.ico" />
