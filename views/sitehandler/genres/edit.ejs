<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" />
</head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <h2 class="page-heading">Rename Genre</h2>
        <p class="page-subheading">Update the name of the genre. This will automatically update all games associated with this genre.</p>
      </div>
      <a href="/sitehandler/genres" class="btn-admin-ghost">← Back to Genres</a>
    </div>

    <div class="form-card" style="max-width:500px">
      <form action="/sitehandler/genres/<%= genre.id %>/update" method="POST" novalidate>
        <div class="form-group">
          <label class="form-label">Genre Name <span class="req">*</span></label>
          <input type="text" name="name" class="form-input" required value="<%= genre.name %>" maxlength="80" />
        </div>
        <div class="form-actions">
          <button type="submit" class="btn-admin-primary">Save Changes</button>
          <a href="/sitehandler/genres" class="btn-admin-ghost">Cancel</a>
        </div>
      </form>
    </div>

  </main>
</div>
<script src="/sitehandler/js/admin.js"></script>
</body>
</html>
