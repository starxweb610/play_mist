<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" />
</head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage: 'dev-submissions', admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <a href="/sitehandler/developer-submissions" style="font-size:.85rem;color:#888;text-decoration:none;display:inline-flex;align-items:center;gap:6px;margin-bottom:8px">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
          Back to Submissions
        </a>
        <h2 class="page-heading"><%= sub.title %></h2>
        <p class="page-subheading">by <%= sub.developer_name %> (<%= sub.studio_name %>)</p>
      </div>
      <% const statusLabel = { pending: 'Pending', under_review: 'Under Review', approved: 'Approved', rejected: 'Rejected' };
         const statusBadge = { pending: 'warning', under_review: 'info', approved: 'success', rejected: 'danger' }; %>
      <span class="badge badge--<%= statusBadge[sub.status] || sub.status %>"><%= statusLabel[sub.status] || sub.status %></span>
    </div>

    <div style="display:grid;grid-template-columns:1fr 340px;gap:24px;align-items:start">

      <!-- Left -->
      <div>
        <!-- Metadata -->
        <div class="card" style="margin-bottom:20px">
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:16px">Submission Info</h3>
          <table style="width:100%;font-size:.875rem;border-collapse:collapse">
            <% const rows = [
              ['Genre',       sub.genre],
              ['Orientation', sub.orientation],
              ['Version',     sub.version],
              ['File Size',   sub.zip_size_fmt],
              ['Developer',   sub.developer_name + ' &lt;' + sub.developer_email + '&gt;'],
              ['Studio',      sub.studio_name],
              ['Country',     sub.country],
              ['Submitted',   new Date(sub.created_at).toLocaleString()],
              sub.reviewed_at ? ['Reviewed', new Date(sub.reviewed_at).toLocaleString()] : null,
              sub.reviewer_name ? ['Reviewed by', sub.reviewer_name] : null,
            ].filter(Boolean); %>
            <% rows.forEach(([k,v]) => { %>
            <tr>
              <td style="padding:8px 0;color:#888;width:130px;vertical-align:top"><%= k %></td>
              <td style="padding:8px 0;font-weight:500"><%- v %></td>
            </tr>
            <% }); %>
          </table>
        </div>

        <!-- Description -->
        <div class="card" style="margin-bottom:20px">
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px">Description</h3>
          <div style="background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:8px;padding:16px;font-size:.875rem;color:#ccc;line-height:1.6;white-space:pre-wrap"><%= sub.description %></div>
        </div>

        <% if (sub.rejection_reason) { %>
        <div class="card" style="margin-bottom:20px;border-color:rgba(239,68,68,.3)">
          <h3 style="font-size:1rem;font-weight:700;margin-bottom:12px;color:#f87171">Rejection Reason</h3>
          <div style="background:rgba(239,68,68,.08);border:1px solid rgba(239,68,68,.2);border-radius:8px;padding:16px;font-size:.875rem;color:#fca5a5;line-height:1.5"><%= sub.rejection_reason %></div>
        </div>
        <% } %>
      </div>

      <!-- Right: Actions -->
      <div style="display:flex;flex-direction:column;gap:16px">

        <!-- Download -->
        <div class="card">
          <h3 style="font-size:.95rem;font-weight:700;margin-bottom:12px">Game Build</h3>
          <a href="/sitehandler/developer-submissions/<%= sub.id %>/download" class="btn-admin-primary" style="display:flex;align-items:center;justify-content:center;gap:8px;width:100%;padding:10px;border-radius:8px;text-decoration:none;font-size:.875rem;font-weight:600">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
            Download ZIP
          </a>
          <p style="font-size:.78rem;color:#666;margin-top:8px;text-align:center">Test locally before approving.</p>
        </div>

        <!-- Mark reviewing -->
        <% if (sub.status === 'pending') { %>
        <div class="card">
          <h3 style="font-size:.95rem;font-weight:700;margin-bottom:8px">Start Review</h3>
          <p style="font-size:.82rem;color:#888;margin-bottom:12px">Mark this submission as under review to signal you're testing it.</p>
          <form method="POST" action="/sitehandler/developer-submissions/<%= sub.id %>/mark-reviewing">
            <button type="submit" class="btn-admin-primary" style="width:100%;padding:10px;border-radius:8px;font-size:.875rem;font-weight:600;cursor:pointer;border:none">
              Mark as Under Review
            </button>
          </form>
        </div>
        <% } %>

        <!-- Approve -->
        <% if (sub.status === 'pending' || sub.status === 'under_review') { %>
        <div class="card" style="border-color:rgba(34,197,94,.25)">
          <h3 style="font-size:.95rem;font-weight:700;margin-bottom:8px;color:#86efac">Approve & Publish</h3>
          <p style="font-size:.82rem;color:#888;margin-bottom:12px">
            This will extract the ZIP, upload to R2, and create a <strong>draft</strong> game entry. You'll still need to add thumbnails and publish it from the Games panel. Studio name will be set to <strong><%= sub.studio_name %></strong>.
          </p>
          <form method="POST" action="/sitehandler/developer-submissions/<%= sub.id %>/approve">
            <button type="submit" class="btn-admin-primary" style="width:100%;padding:10px;border-radius:8px;font-size:.875rem;font-weight:600;cursor:pointer;border:none;background:rgba(34,197,94,.2);color:#86efac;border:1px solid rgba(34,197,94,.3)"
              onclick="return confirm('Approve this game and publish it live?')">
              Approve & Publish
            </button>
          </form>
        </div>
        <% } %>

        <!-- Reject -->
        <% if (sub.status === 'pending' || sub.status === 'under_review') { %>
        <div class="card" style="border-color:rgba(239,68,68,.25)">
          <h3 style="font-size:.95rem;font-weight:700;margin-bottom:8px;color:#f87171">Reject</h3>
          <form method="POST" action="/sitehandler/developer-submissions/<%= sub.id %>/reject">
            <div style="margin-bottom:10px">
              <label style="font-size:.8rem;color:#888;display:block;margin-bottom:6px">Reason for rejection (shown to developer)</label>
              <textarea name="rejection_reason" required rows="3"
                style="width:100%;background:rgba(239,68,68,.06);border:1px solid rgba(239,68,68,.25);border-radius:8px;padding:10px;color:#fca5a5;font-family:inherit;font-size:.85rem;resize:vertical"
                placeholder="e.g. Game has broken controls, missing assets..."></textarea>
            </div>
            <button type="submit" style="width:100%;padding:10px;border-radius:8px;font-size:.875rem;font-weight:600;cursor:pointer;background:rgba(239,68,68,.12);color:#f87171;border:1px solid rgba(239,68,68,.3)"
              onclick="return confirm('Reject this submission?')">
              Reject Submission
            </button>
          </form>
        </div>
        <% } %>

        <!-- Developer link -->
        <div class="card">
          <a href="/sitehandler/developers/<%= sub.developer_id %>" style="font-size:.85rem;color:#888;text-decoration:none;display:flex;align-items:center;gap:8px">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2M9 11a4 4 0 100-8 4 4 0 000 8z"/></svg>
            View Developer Profile
          </a>
        </div>

        <% if (sub.status === 'approved' && sub.game_id) { %>
        <div class="card" style="border-color:rgba(34,197,94,.25)">
          <p style="font-size:.78rem;color:#888;margin-bottom:10px">Game is in <strong>draft</strong> — add thumbnails and publish from the Games panel.</p>
          <a href="/sitehandler/games/<%= sub.game_id %>" style="font-size:.875rem;color:#86efac;text-decoration:none;display:flex;align-items:center;gap:8px;font-weight:600">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6M15 3h6v6M10 14L21 3"/></svg>
            Open in Games Panel →
          </a>
        </div>
        <% } %>
      </div>
    </div>

  </main>
</div>
</body>
</html>
