PORT=3000
NODE_ENV=development

# MySQL Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=playmist

# Session (CHANGE THIS in production — use a long random string)
SESSION_SECRET=change_this_to_a_long_random_secret_in_production

# App Config
APP_NAME=Playmist
APP_URL=https://playmist.app

# Store Links (update when app is live)
ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=com.playmist.app
IOS_STORE_URL=https://apps.apple.com/app/playmist/id000000000

JWT_SECRET=change_me_random_64_chars
JWT_REFRESH_SECRET=change_me_random_64_chars

# Cloudflare R2 (game zips, extracted builds, images, screenshots)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Google Play Games Services — web OAuth client (server-side auth-code exchange).
# Same client ID as the app's VITE_GPGS_SERVER_CLIENT_ID; keep the secret here only.
GOOGLE_PGS_CLIENT_ID=
GOOGLE_PGS_CLIENT_SECRET=
