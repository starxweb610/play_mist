<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" /></head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <h2 class="page-heading">Playtest Feedback — <%= game.title %></h2>
        <p class="page-subheading">
          Grouped by demo version, so you can see whether each build actually fixed
          what the previous one was criticised for.
        </p>
      </div>
      <div class="page-header-actions">
        <a href="/sitehandler/games/<%= game.id %>/demo-feedback/export" class="btn-admin-ghost">Export CSV</a>
        <a href="/sitehandler/games/<%= game.id %>" class="btn-admin-ghost">← Back to Game</a>
      </div>
    </div>

    <!-- ── Version selector ──────────────────────────────────────────── -->
    <% if (versions.length > 1) { %>
      <div class="card" style="margin-bottom:24px;">
        <div class="card-body" style="display:flex;gap:10px;flex-wrap:wrap;align-items:center;">
          <span class="text-dim text-sm" style="margin-right:6px">Version</span>
          <% versions.forEach(v => { %>
            <a href="?version=<%= encodeURIComponent(v.demo_version) %>"
               class="<%= v.demo_version === selectedVersion ? 'btn-admin-primary' : 'btn-admin-ghost' %>"
               style="padding:6px 14px;font-size:0.85rem;">
              v<%= v.demo_version %> <span style="opacity:.65">(<%= v.responses %>)</span>
            </a>
          <% }) %>
        </div>
      </div>
    <% } %>

    <!-- ── Summary ───────────────────────────────────────────────────── -->
    <div class="card" style="margin-bottom:28px;">
      <div class="card-header">
        <h3 class="card-title">v<%= selectedVersion %> summary</h3>
        <span class="admin-badge"><%= stats.responses %> response<%= stats.responses === 1 ? '' : 's' %></span>
      </div>
      <div class="card-body">
        <% if (stats.responses === 0) { %>
          <div style="text-align:center;padding:32px 24px;opacity:.5;">
            No feedback on this version yet.
          </div>
        <% } else { %>
          <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:18px;">
            <% [
              { label: 'Overall',     value: stats.avgOverall },
              { label: 'Fun',         value: stats.avgFun },
              { label: 'Difficulty',  value: stats.avgDifficulty },
              { label: 'Performance', value: stats.avgPerformance }
            ].forEach(m => { %>
              <div>
                <div class="text-dim text-sm" style="text-transform:uppercase;letter-spacing:1px;font-size:0.7rem;"><%= m.label %></div>
                <div style="font-size:1.7rem;font-weight:700;margin-top:4px;">
                  <%= m.value || '—' %><% if (m.value) { %><span style="font-size:0.9rem;opacity:.45"> / 5</span><% } %>
                </div>
              </div>
            <% }) %>
            <div>
              <div class="text-dim text-sm" style="text-transform:uppercase;letter-spacing:1px;font-size:0.7rem;">Would play full</div>
              <div style="font-size:1.7rem;font-weight:700;margin-top:4px;"><%= stats.wouldYes %></div>
              <div class="text-dim text-sm"><%= stats.wouldMaybe %> maybe · <%= stats.wouldNo %> no</div>
            </div>
            <div>
              <div class="text-dim text-sm" style="text-transform:uppercase;letter-spacing:1px;font-size:0.7rem;">Avg session</div>
              <div style="font-size:1.7rem;font-weight:700;margin-top:4px;">
                <%= stats.avgSession || '—' %>
              </div>
              <div class="text-dim text-sm">
                <%= stats.withSession %> of <%= stats.responses %> measured
              </div>
            </div>
          </div>
        <% } %>
      </div>
    </div>

    <!-- ── What players wrote ────────────────────────────────────────── -->
    <% if (feedback.length > 0) { %>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:20px;margin-bottom:28px;">
        <div class="card">
          <div class="card-header"><h3 class="card-title">👍 Enjoyed most</h3></div>
          <div class="card-body">
            <% const liked = feedback.filter(f => f.liked); %>
            <% if (liked.length === 0) { %>
              <div class="text-dim text-sm">No written answers yet.</div>
            <% } else { %>
              <% liked.forEach(f => { %>
                <div style="padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
                  <div style="font-size:0.92rem;line-height:1.5;"><%= f.liked %></div>
                  <div class="text-dim text-sm" style="margin-top:4px;">— <%= f.display_name || f.username %></div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
        <div class="card">
          <div class="card-header"><h3 class="card-title">👎 Biggest frustration</h3></div>
          <div class="card-body">
            <% const gripes = feedback.filter(f => f.frustration); %>
            <% if (gripes.length === 0) { %>
              <div class="text-dim text-sm">No written answers yet.</div>
            <% } else { %>
              <% gripes.forEach(f => { %>
                <div style="padding:10px 0;border-bottom:1px solid rgba(255,255,255,0.06);">
                  <div style="font-size:0.92rem;line-height:1.5;"><%= f.frustration %></div>
                  <div class="text-dim text-sm" style="margin-top:4px;">— <%= f.display_name || f.username %></div>
                </div>
              <% }) %>
            <% } %>
          </div>
        </div>
      </div>
    <% } %>

    <!-- ── All responses ─────────────────────────────────────────────── -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">All responses</h3>
        <span class="admin-badge"><%= feedback.length %></span>
      </div>
      <div class="card-body" style="padding:0;">
        <% if (feedback.length === 0) { %>
          <div style="text-align:center;padding:48px 24px;opacity:.5;">Nothing yet.</div>
        <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Player</th>
                <th>Overall</th>
                <th>Fun</th>
                <th>Difficulty</th>
                <th>Perf</th>
                <th>Would play</th>
                <th>Session</th>
                <th>Device</th>
                <th>Submitted</th>
              </tr>
            </thead>
            <tbody>
              <% feedback.forEach(f => { %>
                <tr>
                  <td><%= f.display_name || f.username %></td>
                  <td><strong><%= f.overall %></strong>/5</td>
                  <td><%= f.fun ?? '—' %></td>
                  <td><%= f.difficulty ?? '—' %></td>
                  <td><%= f.performance ?? '—' %></td>
                  <td><%= f.would_play || '—' %></td>
                  <td><%= f.session_label || '—' %></td>
                  <td><%= f.device || '—' %></td>
                  <td><%= f.created_at ? f.created_at.toLocaleDateString() : '—' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

  </main>
</div>
</body>
</html>
