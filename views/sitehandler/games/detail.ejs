<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" />
</head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div style="display:flex;align-items:center;gap:12px">
        <div>
          <h2 class="page-heading"><%= game.title %></h2>
          <div style="display:flex;gap:8px;margin-top:6px;align-items:center">
            <span class="badge badge--<%= game.type %>"><%= game.type.toUpperCase() %></span>
            <span class="badge badge--orient"><%= game.orientation %></span>
            <span class="badge <%= game.is_active ? 'badge--active' : 'badge--inactive' %>"><%= game.is_active ? 'Active' : 'Draft' %></span>
            <span class="text-dim text-sm">/<%= game.slug %></span>
          </div>
        </div>
      </div>
      <div class="page-header-actions">
        <% if ((game.type === 'webgl' || game.type === 'premium') && game.play_url) { %>
          <a href="<%= game.play_url %>" target="_blank" class="btn-admin-primary">▶ Test Game</a>
        <% } %>
        <a href="/sitehandler/games/<%= game.id %>/xp-events" class="btn-admin-ghost">XP Events</a>
        <a href="/sitehandler/games/<%= game.id %>/funnel-events" class="btn-admin-ghost">Funnel Analytics</a>
        <a href="/sitehandler/games/<%= game.id %>/shop-items" class="btn-admin-ghost">Shop Items</a>
        <a href="/sitehandler/games" class="btn-admin-ghost">← All Games</a>
      </div>
    </div>

    <div class="detail-layout">

      <!-- LEFT: Game Info Form -->
      <div class="detail-main">
        <div class="form-card">
          <h3 class="form-card-title">Game Info</h3>
          <form action="/sitehandler/games/<%= game.id %>/update" method="POST" novalidate>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Title <span class="req">*</span></label>
                <input type="text" name="title" class="form-input" value="<%= game.title %>" required maxlength="200" />
              </div>
              <div class="form-group">
                <label class="form-label">Slug (auto-generated)</label>
                <input type="text" class="form-input form-input--readonly" value="<%= game.slug %>" readonly />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Genre</label>
                <select name="genre" class="form-input">
                  <% genres.forEach(g => { %><option value="<%= g.name %>" <%= game.genre === g.name ? 'selected' : '' %>><%= g.name %></option><% }) %>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Version</label>
                <input type="text" name="version" class="form-input" value="<%= game.version || '1.0.0' %>" placeholder="1.0.0" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Game Type</label>
                <select name="type" class="form-input">
                  <option value="webgl"    <%= game.type === 'webgl'    ? 'selected' : '' %>>⚡ WebGL (Instant)</option>
                  <option value="premium"  <%= game.type === 'premium'  ? 'selected' : '' %>>👑 Premium (Offline)</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label">Orientation</label>
                <select name="orientation" class="form-input">
                  <option value="landscape" <%= game.orientation === 'landscape' ? 'selected' : '' %>>🖥️ Landscape</option>
                  <option value="portrait"  <%= game.orientation === 'portrait'  ? 'selected' : '' %>>📱 Portrait</option>
                </select>
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Studio / Developer</label>
                <input type="text" name="studio" class="form-input" value="<%= game.studio || '' %>" placeholder="e.g. Tiny Bear" />
              </div>
              <div class="form-group">
                <label class="form-label">Build Size <span style="font-size:0.7rem;color:var(--a-text-dim);text-transform:none;letter-spacing:0;font-weight:400">auto — from uploaded ZIP</span></label>
                <input type="text" class="form-input" value="<%= game.size || 'Upload a build to capture' %>" readonly disabled style="opacity:0.65;cursor:not-allowed" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Plays <span style="font-size:0.7rem;color:var(--a-text-dim);text-transform:none;letter-spacing:0;font-weight:400">auto — from analytics</span></label>
                <input type="text" class="form-input" value="<%= liveStats.playCount %>" readonly disabled style="opacity:0.65;cursor:not-allowed" />
              </div>
              <div class="form-group">
                <label class="form-label">Rating <span style="font-size:0.7rem;color:var(--a-text-dim);text-transform:none;letter-spacing:0;font-weight:400">auto — from user ratings</span></label>
                <input type="text" class="form-input" value="<%= liveStats.avgRating ? `${liveStats.avgRating} ★ (${liveStats.ratingCount} rating${liveStats.ratingCount === 1 ? '' : 's'})` : 'Not rated yet' %>" readonly disabled style="opacity:0.65;cursor:not-allowed" />
              </div>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Credits Cost</label>
                <input type="number" name="credits_cost" class="form-input" value="<%= game.credits_cost || '' %>" placeholder="e.g. 10" />
              </div>
              <div class="form-group">
                <label class="form-label">Flag / Badge</label>
                <input type="text" name="flag" class="form-input" value="<%= game.flag || '' %>" placeholder="e.g. NEW, HOT (optional)" />
              </div>
            </div>

            <div class="form-group">
              <label class="form-label">
                Short Description
                <span class="char-counter" id="descCounter"><%= (game.short_description || '').length %> / 200</span>
              </label>
              <textarea name="short_description" class="form-input form-textarea" maxlength="200" rows="3"
                id="descTextarea"><%= game.short_description || '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Long Description</label>
              <textarea name="long_description" class="form-input form-textarea" rows="6"
                placeholder="Full game description — gameplay mechanics, features, controls, etc."
                ><%= game.long_description || '' %></textarea>
            </div>

            <div class="form-group">
              <label class="form-label">Tags / Features</label>
              <% if (tags.length > 0) { %>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 12px; padding: 16px; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.06); border-radius: 8px; margin-top: 6px;">
                  <% tags.forEach(t => { %>
                    <label style="display: flex; align-items: center; gap: 8px; font-family: var(--body); font-size: 0.9rem; color: var(--a-text); cursor: pointer;">
                      <input type="checkbox" name="tags" value="<%= t.id %>" <%= selectedTagIds.includes(t.id) ? 'checked' : '' %> style="cursor: pointer; width: 16px; height: 16px; accent-color: var(--a-accent);" />
                      <span><%= t.name %></span>
                    </label>
                  <% }) %>
                </div>
              <% } else { %>
                <p class="text-dim text-sm" style="margin-top:6px">No tags defined yet. <a href="/sitehandler/tags" target="_blank" style="color:var(--a-accent)">Add tags here ↗</a></p>
              <% } %>
            </div>

            <div class="form-group">
              <label class="form-label">
                Trailer Video URL
                <span style="font-size:0.7rem;color:var(--a-text-dim);text-transform:none;letter-spacing:0;font-weight:400">.mp4 direct link</span>
              </label>
              <div class="trailer-input-row">
                <input type="url" name="trailer_url" class="form-input" id="trailerUrlInput"
                  value="<%= game.trailer_url || '' %>"
                  placeholder="https://cdn.example.com/trailers/my-game.mp4" />
                <% if (game.trailer_url) { %>
                  <a href="<%= game.trailer_url %>" target="_blank" class="btn-admin-ghost trailer-preview-btn" title="Preview trailer">▶</a>
                <% } %>
              </div>
              <% if (game.trailer_url) { %>
                <video class="trailer-preview" src="<%= game.trailer_url %>" controls preload="none" muted></video>
              <% } %>
            </div>

            <div class="form-row-2">
              <div class="form-group">
                <label class="form-label">Visibility</label>
                <div style="display: flex; align-items: center; gap: 10px; margin-top: 6px;">
                  <label class="toggle-switch" title="<%= game.is_active ? 'Active' : 'Draft' %>">
                    <input type="checkbox" name="is_active" <%= game.is_active ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                  <span class="text-dim text-sm">Active (visible to players)</span>
                </div>
              </div>
              <div class="form-group">
                <label class="form-label">Featured</label>
                <div style="display: flex; align-items: center; gap: 10px; margin-top: 6px;">
                  <label class="toggle-switch" title="<%= game.is_featured ? 'Featured' : 'Not Featured' %>">
                    <input type="checkbox" name="is_featured" <%= game.is_featured ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                  <span class="text-dim text-sm">Show in featured section</span>
                </div>
              </div>
            </div>

            <!-- Release stage: 'in_development' moves the game out of the live
                 catalog entirely and into the app's Coming Soon rail. -->
            <div class="form-group">
              <label class="form-label">Release Stage</label>
              <select name="release_stage" class="form-input" id="releaseStageSelect">
                <option value="live" <%= game.release_stage !== 'in_development' ? 'selected' : '' %>>Live — in the normal catalog</option>
                <option value="in_development" <%= game.release_stage === 'in_development' ? 'selected' : '' %>>In development — Coming Soon rail only</option>
              </select>
              <p class="text-dim text-sm" style="margin-top:6px">
                In-development games are forced inactive: they never appear in the catalog,
                search, the website or the daily pick — only in the app's Coming Soon rail
                (max 5, lowest rank first).
              </p>
            </div>

            <div id="comingSoonFields" style="display:<%= game.release_stage === 'in_development' ? 'block' : 'none' %>">
              <div class="form-row-2">
                <div class="form-group">
                  <label class="form-label">Expected Release</label>
                  <input type="text" name="expected_release" class="form-input"
                    value="<%= game.expected_release || '' %>" placeholder="e.g. Q1 2027, Winter 2026" />
                </div>
                <div class="form-group">
                  <label class="form-label">Coming Soon Rank</label>
                  <input type="number" name="coming_soon_rank" class="form-input"
                    value="<%= game.coming_soon_rank || 0 %>" placeholder="0" />
                </div>
              </div>
            </div>

            <div class="form-actions">
              <button type="submit" class="btn-admin-primary">Save Changes</button>
            </div>
          </form>

          <script>
            (function () {
              var sel = document.getElementById('releaseStageSelect');
              var box = document.getElementById('comingSoonFields');
              if (!sel || !box) return;
              sel.addEventListener('change', function () {
                box.style.display = sel.value === 'in_development' ? 'block' : 'none';
              });
            })();
          </script>
        </div>
      </div>


      <!-- RIGHT: File Upload Sidebar -->
      <div class="detail-sidebar">

        <!-- File Status -->
        <div class="form-card">
          <h3 class="form-card-title">Game Files</h3>
          <% if (game.file_path) { %>
            <div class="file-status file-status--ok">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
              <span>Files uploaded</span>
            </div>
            <% if ((game.type === 'webgl' || game.type === 'premium') && game.play_url) { %>
              <div class="play-url-box">
                <span class="play-url-label">Play URL</span>
                <a href="<%= game.play_url %>" target="_blank" class="play-url-link"><%= game.play_url %> ↗</a>
              </div>
            <% } %>
            <p class="text-dim text-sm" style="margin-top:8px">Upload a new zip below to replace files.</p>
          <% } else { %>
            <div class="file-status file-status--pending">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              <span>No files uploaded yet</span>
            </div>
          <% } %>
        </div>

        <!-- Upload Zone -->
        <div class="form-card">
          <h3 class="form-card-title">
            Upload WebGL Build (.zip)
          </h3>
          <div class="upload-hint">
            <strong>WebGL Requirements:</strong>
            <ul>
              <li>Zip must contain <code>index.html</code> at root (or inside one subfolder)</li>
              <li>Max file size: 600 MB</li>
              <li>Original zip is preserved as <code>game.zip</code> inside the extracted folder</li>
            </ul>
          </div>

          <form action="/sitehandler/games/<%= game.id %>/upload" method="POST"
                enctype="multipart/form-data" id="uploadForm">
            <div class="drop-zone" id="dropZone">
              <input type="file" name="game_zip" id="zipInput" accept=".zip" required class="drop-input" />
              <div class="drop-text" id="dropText">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                <span>Drop .zip here or click to browse</span>
                <span class="drop-sub" id="dropFilename"></span>
              </div>
            </div>
            <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:12px" id="uploadBtn">
              Upload & Extract
            </button>
          </form>
        </div>

        <!-- Demo build — only meaningful while the game is in development -->
        <div class="form-card">
          <h3 class="form-card-title">🧪 Playtest Demo Build</h3>

          <% if (game.release_stage !== 'in_development') { %>
            <p class="text-dim text-sm">
              Set <strong>Release Stage</strong> to “In development” and save to publish a demo
              players can test from the Coming Soon rail.
            </p>
          <% } else { %>
            <% if (game.demo_zip_url) { %>
              <div class="file-status file-status--ok">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                <span>Demo v<%= game.demo_version || '0.1.0' %> uploaded<%= game.demo_size_label ? ' · ' + game.demo_size_label : '' %></span>
              </div>
              <div style="display:flex;align-items:center;gap:10px;margin:12px 0">
                <form action="/sitehandler/games/<%= game.id %>/demo-toggle" method="POST" style="display:flex;align-items:center;gap:10px">
                  <label class="toggle-switch" title="<%= game.demo_enabled ? 'Demo live' : 'Demo hidden' %>">
                    <input type="checkbox" name="demo_enabled" onchange="this.form.submit()" <%= game.demo_enabled ? 'checked' : '' %>>
                    <span class="toggle-slider"></span>
                  </label>
                  <span class="text-dim text-sm">
                    <%= game.demo_enabled ? 'Players can play this demo' : 'Demo hidden from players' %>
                  </span>
                </form>
              </div>
              <a href="/sitehandler/games/<%= game.id %>/demo-feedback" class="btn-admin-ghost" style="width:100%;display:block;text-align:center">
                View playtest feedback →
              </a>
            <% } else { %>
              <div class="file-status file-status--pending">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                <span>No demo build yet</span>
              </div>
            <% } %>

            <div class="upload-hint" style="margin-top:12px">
              <strong>Demo builds are separate</strong> from the final build above — uploading one
              never touches the real <code>zip_url</code>. Bump the version on each new build so
              feedback stays comparable across iterations.
            </div>

            <form action="/sitehandler/games/<%= game.id %>/upload-demo" method="POST"
                  enctype="multipart/form-data">
              <div class="form-group">
                <label class="form-label">Demo Version</label>
                <input type="text" name="demo_version" class="form-input"
                       value="<%= game.demo_version || '0.1.0' %>" placeholder="0.1.0" required />
              </div>
              <div class="drop-zone">
                <input type="file" name="demo_zip" accept=".zip" required class="drop-input" />
                <div class="drop-text">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/></svg>
                  <span>Drop demo .zip here or click to browse</span>
                </div>
              </div>
              <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:12px">
                Upload Demo Build
              </button>
            </form>
          <% } %>
        </div>

        <!-- Thumbnail Image Upload -->
        <div class="form-card">
          <h3 class="form-card-title">🖼️ Game Thumbnail</h3>

          <% if (game.thumbnail_url) { %>
            <div class="thumb-preview-wrap">
              <img src="<%= game.thumbnail_url %>" alt="<%= game.title %> thumbnail"
                   class="thumb-preview" id="thumbPreviewImg" />
              <div class="thumb-overlay">
                <span>Current thumbnail</span>
              </div>
            </div>
            <div class="play-url-box" style="margin-top:10px">
              <span class="play-url-label">Image URL</span>
              <span class="play-url-link" style="word-break:break-all"><%= game.thumbnail_url %></span>
            </div>
          <% } else { %>
            <div class="thumb-placeholder" id="thumbPlaceholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>No thumbnail yet</span>
            </div>
          <% } %>

          <form action="/sitehandler/games/<%= game.id %>/upload-image" method="POST"
                enctype="multipart/form-data" id="imgForm" style="margin-top:14px">
            <div class="drop-zone drop-zone--img" id="imgDropZone">
              <input type="file" name="game_image" id="imgInput"
                     accept="image/jpeg,image/png,image/webp" required class="drop-input" />
              <div class="drop-text">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>JPG · PNG · WebP — max 10 MB</span>
                <span class="drop-sub" id="imgFilename"></span>
              </div>
            </div>
            <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:10px" id="imgUploadBtn">
              Upload Thumbnail
            </button>
          </form>
        </div>

        <!-- Secondary Thumbnail Image Upload -->
        <div class="form-card">
          <h3 class="form-card-title">🖼️ Secondary Thumbnail</h3>

          <% if (game.secondary_thumbnail) { %>
            <div class="thumb-preview-wrap">
              <img src="<%= game.secondary_thumbnail %>" alt="<%= game.title %> secondary thumbnail"
                   class="thumb-preview" id="secondaryPreviewImg" />
              <div class="thumb-overlay">
                <span>Current secondary thumbnail</span>
              </div>
            </div>
            <div class="play-url-box" style="margin-top:10px">
              <span class="play-url-label">Image URL</span>
              <span class="play-url-link" style="word-break:break-all"><%= game.secondary_thumbnail %></span>
            </div>
          <% } else { %>
            <div class="thumb-placeholder" id="secondaryPlaceholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>No secondary thumbnail yet</span>
            </div>
          <% } %>

          <form action="/sitehandler/games/<%= game.id %>/upload-secondary-image" method="POST"
                enctype="multipart/form-data" id="secondaryImgForm" style="margin-top:14px">
            <div class="drop-zone drop-zone--img" id="secondaryImgDropZone">
              <input type="file" name="secondary_image" id="secondaryImgInput"
                     accept="image/jpeg,image/png,image/webp" required class="drop-input" />
              <div class="drop-text">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>JPG · PNG · WebP — max 10 MB</span>
                <span class="drop-sub" id="secondaryImgFilename"></span>
              </div>
            </div>
            <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:10px" id="secondaryImgUploadBtn">
              Upload Secondary Thumbnail
            </button>
          </form>
        </div>

        <!-- Promotional Thumbnail Image Upload -->
        <div class="form-card">
          <h3 class="form-card-title">🖼️ Promotional Thumbnail</h3>

          <% if (game.promotional_thumbnail) { %>
            <div class="thumb-preview-wrap">
              <img src="<%= game.promotional_thumbnail %>" alt="<%= game.title %> promotional thumbnail"
                   class="thumb-preview" id="promoPreviewImg" />
              <div class="thumb-overlay">
                <span>Current promotional thumbnail</span>
              </div>
            </div>
            <div class="play-url-box" style="margin-top:10px">
              <span class="play-url-label">Image URL</span>
              <span class="play-url-link" style="word-break:break-all"><%= game.promotional_thumbnail %></span>
            </div>
          <% } else { %>
            <div class="thumb-placeholder" id="promoPlaceholder">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="36" height="36"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              <span>No promotional thumbnail yet</span>
            </div>
          <% } %>

          <form action="/sitehandler/games/<%= game.id %>/upload-promotional-image" method="POST"
                enctype="multipart/form-data" id="promoImgForm" style="margin-top:14px">
            <div class="drop-zone drop-zone--img" id="promoImgDropZone">
              <input type="file" name="promotional_image" id="promoImgInput"
                     accept="image/jpeg,image/png,image/webp" required class="drop-input" />
              <div class="drop-text">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="24" height="24"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span>JPG · PNG · WebP — max 10 MB</span>
                <span class="drop-sub" id="promoImgFilename"></span>
              </div>
            </div>
            <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:10px" id="promoImgUploadBtn">
              Upload Promotional Thumbnail
            </button>
          </form>
        </div>

        <!-- Game Screenshots Upload -->
        <div class="form-card">
          <h3 class="form-card-title">📸 Game Screenshots</h3>

          <% if (screenshots.length > 0) { %>
            <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 10px; margin-bottom: 16px;">
              <% screenshots.forEach(s => { %>
                <div style="position: relative; border-radius: 8px; overflow: hidden; aspect-ratio: 16/9; border: 1px solid rgba(255,255,255,0.08); box-shadow: 0 4px 10px rgba(0,0,0,0.35);">
                  <img src="<%= s.image_url %>" alt="Screenshot" style="width: 100%; height: 100%; object-fit: cover;" />
                  <form action="/sitehandler/games/<%= game.id %>/delete-screenshot/<%= s.id %>" method="POST" style="position: absolute; top: 4px; right: 4px; margin: 0;">
                    <button type="submit" class="action-btn action-btn--danger" style="padding: 4px 8px; font-size: 0.75rem; border-radius: 4px; box-shadow: 0 2px 6px rgba(0,0,0,0.5);" data-confirm="Delete this screenshot?">✕</button>
                  </form>
                </div>
              <% }) %>
            </div>
          <% } else { %>
            <div class="thumb-placeholder" style="margin-bottom: 16px; height: 100px;">
              <span>No screenshots uploaded yet</span>
            </div>
          <% } %>

          <form action="/sitehandler/games/<%= game.id %>/upload-screenshots" method="POST" enctype="multipart/form-data">
            <div class="drop-zone drop-zone--img" id="screenshotsDropZone" style="height: 100px;">
              <input type="file" name="screenshots" id="screenshotsInput" accept="image/jpeg,image/png,image/webp" required multiple class="drop-input" />
              <div class="drop-text" style="padding: 10px;">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="20" height="20"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
                <span style="font-size: 0.8rem;">Select one or more screenshots</span>
                <span class="drop-sub" id="screenshotsFilename" style="font-size: 0.75rem; color: var(--a-accent);"></span>
              </div>
            </div>
            <button type="submit" class="btn-admin-primary" style="width:100%;margin-top:10px" id="screenshotsUploadBtn">
              Upload Screenshots
            </button>
          </form>
        </div>

        <!-- Danger Zone -->
        <div class="form-card form-card--danger">
          <h3 class="form-card-title form-card-title--danger">Danger Zone</h3>
          <p class="text-dim text-sm">This will permanently delete the game and all its files.</p>
          <form action="/sitehandler/games/<%= game.id %>/delete" method="POST" style="margin-top:12px">
            <button type="submit" class="btn-danger" data-confirm="Delete '<%= game.title %>'? This cannot be undone and will remove all uploaded files.">
              Delete This Game
            </button>
          </form>
        </div>

      </div><!-- /detail-sidebar -->
    </div><!-- /detail-layout -->

  </main>
</div>
<script src="/sitehandler/js/admin.js"></script>
<script>
  // Char counter
  const ta = document.getElementById('descTextarea');
  const counter = document.getElementById('descCounter');
  ta.addEventListener('input', () => {
    counter.textContent = `${ta.value.length} / 200`;
    counter.style.color = ta.value.length > 180 ? '#f59e0b' : '';
  });

  // Drop zone
  const dropZone = document.getElementById('dropZone');
  const zipInput = document.getElementById('zipInput');
  const dropText = document.getElementById('dropFilename');
  const uploadBtn = document.getElementById('uploadBtn');

  zipInput.addEventListener('change', () => {
    if (zipInput.files[0]) {
      dropText.textContent = '📦 ' + zipInput.files[0].name;
      uploadBtn.textContent = `Upload "${zipInput.files[0].name}"`;
    }
  });

  dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('drag-over');
    if (e.dataTransfer.files[0]) {
      zipInput.files = e.dataTransfer.files;
      dropText.textContent = '📦 ' + e.dataTransfer.files[0].name;
      uploadBtn.textContent = `Upload "${e.dataTransfer.files[0].name}"`;
    }
  });

  // Upload progress feedback
  document.getElementById('uploadForm').addEventListener('submit', () => {
    uploadBtn.textContent = '⏳ Uploading & Extracting...';
    uploadBtn.disabled = true;
  });

  // ── Image upload zones helper ────────────────────────────────────────────────
  function setupImageUploadZone(dropZoneId, inputId, filenameId, uploadBtnId, formId, previewImgId, placeholderId) {
    const dropZone = document.getElementById(dropZoneId);
    const input = document.getElementById(inputId);
    const filename = document.getElementById(filenameId);
    const uploadBtn = document.getElementById(uploadBtnId);
    const form = document.getElementById(formId);

    if (!input) return;

    function handleFile(file) {
      if (!file) return;
      filename.textContent = '🖼️ ' + file.name;
      uploadBtn.textContent = `Upload "${file.name}"`;

      const reader = new FileReader();
      reader.onload = e => {
        const existing = document.getElementById(previewImgId);
        const placeholder = document.getElementById(placeholderId);
        if (existing) {
          existing.src = e.target.result;
        } else if (placeholder) {
          placeholder.innerHTML = `<img src="${e.target.result}" class="thumb-preview" style="border-radius:8px;width:100%;object-fit:cover;max-height:160px" />`;
        }
      };
      reader.readAsDataURL(file);
    }

    input.addEventListener('change', () => handleFile(input.files[0]));

    dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
    dropZone.addEventListener('drop', e => {
      e.preventDefault();
      dropZone.classList.remove('drag-over');
      const file = e.dataTransfer.files[0];
      if (file) { input.files = e.dataTransfer.files; handleFile(file); }
    });

    form.addEventListener('submit', () => {
      uploadBtn.textContent = '⏳ Uploading...';
      uploadBtn.disabled = true;
    });
  }

  // Initialize upload zones
  setupImageUploadZone('imgDropZone', 'imgInput', 'imgFilename', 'imgUploadBtn', 'imgForm', 'thumbPreviewImg', 'thumbPlaceholder');
  setupImageUploadZone('secondaryImgDropZone', 'secondaryImgInput', 'secondaryImgFilename', 'secondaryImgUploadBtn', 'secondaryImgForm', 'secondaryPreviewImg', 'secondaryPlaceholder');
  setupImageUploadZone('promoImgDropZone', 'promoImgInput', 'promoImgFilename', 'promoImgUploadBtn', 'promoImgForm', 'promoPreviewImg', 'promoPlaceholder');

  // ── Screenshots upload feedback ──────────────────────────────────────────
  const screenshotsInput = document.getElementById('screenshotsInput');
  const screenshotsFilename = document.getElementById('screenshotsFilename');
  const screenshotsUploadBtn = document.getElementById('screenshotsUploadBtn');
  const screenshotsDropZone = document.getElementById('screenshotsDropZone');

  if (screenshotsInput) {
    screenshotsInput.addEventListener('change', () => {
      const count = screenshotsInput.files.length;
      if (count > 0) {
        screenshotsFilename.textContent = `Selected ${count} file(s)`;
        screenshotsUploadBtn.textContent = `Upload ${count} Screenshot(s)`;
      }
    });

    screenshotsDropZone.addEventListener('dragover', e => { e.preventDefault(); screenshotsDropZone.classList.add('drag-over'); });
    screenshotsDropZone.addEventListener('dragleave', () => screenshotsDropZone.classList.remove('drag-over'));
    screenshotsDropZone.addEventListener('drop', e => {
      e.preventDefault();
      screenshotsDropZone.classList.remove('drag-over');
      if (e.dataTransfer.files.length > 0) {
        screenshotsInput.files = e.dataTransfer.files;
        const count = e.dataTransfer.files.length;
        screenshotsFilename.textContent = `Selected ${count} file(s)`;
        screenshotsUploadBtn.textContent = `Upload ${count} Screenshot(s)`;
      }
    });
  }
</script>
</body>
</html>
