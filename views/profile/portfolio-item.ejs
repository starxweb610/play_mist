<!DOCTYPE html>
<html lang="en">
<head>
  <%
    const itemUrl = `${appUrl}/@${dev.handle}/portfolio/${item.id}`;
    const ld = {
      '@context': 'https://schema.org',
      '@type': 'CreativeWork',
      name: item.title,
      url: itemUrl,
      image: item.image_url,
      description: item.description.replace(/\s+/g, ' ').slice(0, 300),
      author: { '@type': 'Person', name: dev.name, url: `${appUrl}/@${dev.handle}` },
      sameAs: item.links.filter(l => l.field !== 'drive_url').map(l => l.url),
      video: item.watchUrl ? { '@type': 'VideoObject', name: `${item.title} trailer`, embedUrl: item.embedUrl, url: item.watchUrl, thumbnailUrl: item.image_url, uploadDate: new Date(item.updated_at).toISOString() } : undefined,
    };
  %>
  <%- include('partials/head', {
        title,
        description: item.description.replace(/\s+/g, ' ').trim().slice(0, 160),
        canonical: itemUrl, robots: 'index, follow', ogImage: item.image_url, ogType: 'website',
      }) %>
  <script type="application/ld+json"><%- JSON.stringify(ld).replace(/</g, '\\u003c') %></script>
</head>
<body>
  <%- include('../partials/navbar', { appName, scrolled: true }) %>

  <main class="pf-page pj-page">
    <div class="container">
      <nav class="pj-crumbs" aria-label="Breadcrumb">
        <a href="/@<%= dev.handle %>" class="pj-crumb-dev">
          <span class="pf-avatar pf-avatar--xxs">
            <% if (dev.avatar_url) { %><img src="<%= dev.avatar_url %>" alt="" /><% } else { %><%= dev.name.charAt(0).toUpperCase() %><% } %>
          </span>
          <%= dev.name %>
        </a>
        <span aria-hidden="true">/</span>
        <a href="/@<%= dev.handle %>#portfolio">External Portfolio</a>
        <span aria-hidden="true">/</span>
        <span aria-current="page"><%= item.title %></span>
      </nav>

      <header class="pj-head">
        <div style="min-width:0;flex:1;">
          <div class="pj-kicker">
            <span class="pf-pill">External project</span>
            <span class="pj-readonly">by <a href="/@<%= dev.handle %>" class="fo-byline">@<%= dev.handle %></a></span>
          </div>
          <h1 class="pj-title"><%= item.title %></h1>
        </div>
        <div class="pf-actions">
          <% if (viewer.isSelf) { %>
            <a href="/developer/portfolio/<%= item.id %>/edit" class="btn btn-ghost pf-btn pf-btn--sm">Edit in portal</a>
          <% } %>
          <button type="button" class="btn btn-ghost pf-btn pf-btn--sm" data-share="<%= itemUrl %>" data-share-title="<%= item.title %> by <%= dev.name %>">Share</button>
        </div>
      </header>

      <div class="fo-layout">
        <div style="min-width:0;">
          <div class="fo-media">
            <% if (item.embedUrl) { %>
              <iframe src="<%= item.embedUrl %>" title="<%= item.title %> trailer" loading="lazy"
                      allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                      allowfullscreen referrerpolicy="strict-origin-when-cross-origin"
                      sandbox="allow-scripts allow-same-origin allow-presentation allow-popups allow-popups-to-escape-sandbox"></iframe>
            <% } else { %>
              <img src="<%= item.image_url %>" alt="<%= item.title %>" />
            <% } %>
          </div>
          <h2 class="fo-heading">About this project</h2>
          <p class="fo-desc"><%= item.description %></p>
        </div>

        <aside class="pf-card fo-aside">
          <% if (item.embedUrl) { %><img class="fo-aside-img" src="<%= item.image_url %>" alt="<%= item.title %>" /><% } %>
          <% if (item.links.length) { %>
            <h2 class="pf-card-title">Get it on</h2>
            <div class="fo-links">
              <% item.links.forEach(l => { let host = ''; try { host = new URL(l.url).hostname.replace(/^www\./, ''); } catch (_) {} %>
                <a class="fo-link" href="<%= l.url %>" target="_blank" rel="noopener nofollow ugc">
                  <span><%= l.label %><small><%= host %></small></span>
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                </a>
              <% }) %>
            </div>
          <% } else { %>
            <p class="pf-muted">No store links have been added for this project.</p>
          <% } %>
          <p class="fo-note">Links open external websites not operated by <%= appName %>.</p>
        </aside>
      </div>

      <% if (others.length) { %>
        <section class="pf-section fo-more">
          <div class="pf-section-head">
            <h2 class="pf-section-title">More from <%= dev.name %></h2>
            <a href="/@<%= dev.handle %>#portfolio" class="pf-count">View profile →</a>
          </div>
          <div class="pf-folio-grid">
            <% others.forEach(o => { %>
              <a href="/@<%= dev.handle %>/portfolio/<%= o.id %>" class="pf-folio">
                <span class="pf-folio-media"><img src="<%= o.image_url %>" alt="<%= o.title %>" loading="lazy" /></span>
                <span class="pf-folio-body"><span class="pf-folio-title"><%= o.title %></span></span>
              </a>
            <% }) %>
          </div>
        </section>
      <% } %>
    </div>
  </main>

  <%- include('../partials/footer', { appName }) %>
  <script src="/js/main.js"></script>
  <script src="/js/profile.js" defer></script>
</body>
</html>
