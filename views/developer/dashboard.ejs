<!DOCTYPE html>
<html lang="en">
<head><%- include('partials/head', { title: 'Dashboard' }) %>  <link rel="icon" href="/favicon.ico" />
</head>
<body>
<div class="container-app">
  <%- include('partials/sidebar', { activePage: 'dashboard', developer, appName }) %>

  <main class="main-content">
    <header class="topbar">
      <button class="dev-menu-btn" id="devMenuBtn" aria-label="Open navigation">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
      <span class="topbar-title">My Submissions</span>
      <div class="top-actions">
        <a href="/" target="_blank" class="btn ghost sm">View Site</a>
      </div>
    </header>

    <div class="page-content scroll">
      <%- include('partials/flash') %>

      <%
        const drafts    = submissions.filter(s => s.status === 'draft').length;
        const pending   = submissions.filter(s => s.status === 'pending').length;
        const reviewing = submissions.filter(s => s.status === 'under_review').length;
        const approved  = submissions.filter(s => s.status === 'approved').length;
        const rejected  = submissions.filter(s => s.status === 'rejected').length;
      %>

      <!-- KPI Row -->
      <div class="kpi-row">
        <div class="kpi">
          <div class="icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/></svg>
          </div>
          <div class="label">Total</div>
          <div class="value num"><%= submissions.length %></div>
        </div>

        <div class="kpi purple-i">
          <div class="icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
          </div>
          <div class="label">Drafts</div>
          <div class="value num"><%= drafts %></div>
        </div>

        <div class="kpi warn-i">
          <div class="icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          </div>
          <div class="label">In Review</div>
          <div class="value num"><%= pending + reviewing %></div>
        </div>

        <div class="kpi ok-i">
          <div class="icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 11-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <div class="label">Published</div>
          <div class="value num"><%= approved %></div>
        </div>

        <div class="kpi danger-i">
          <div class="icon-pill">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>
          </div>
          <div class="label">Rejected</div>
          <div class="value num"><%= rejected %></div>
        </div>
      </div>

      <!-- Submissions card -->
      <div class="card" style="padding:0;overflow:hidden;">
        <div class="section-h">
          <h3>Game Submissions</h3>
          <a href="/developer/submit" class="btn primary sm">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" width="13" height="13"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
            Submit New Game
          </a>
        </div>

        <% if (submissions.length === 0) { %>
          <div class="empty-state">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
            <h3>No submissions yet</h3>
            <p>Upload your HTML5 game ZIP and get it published on PlayMist.</p>
            <a href="/developer/submit" class="btn primary">Submit Your First Game</a>
          </div>
        <% } else { %>
          <div class="table-scroll-wrap">
            <table class="list-table">
              <thead>
                <tr>
                  <th>Game</th>
                  <th>Genre</th>
                  <th>Version</th>
                  <th>Status</th>
                  <th>Submitted</th>
                  <th></th>
                </tr>
              </thead>
              <tbody>
                <% submissions.forEach(s => {
                  const statusLabel = { draft: 'Draft', pending: 'Pending', under_review: 'Under Review', approved: 'Approved', rejected: 'Rejected' };
                  const statusCls   = { draft: 'badge-draft', pending: 'badge-pending', under_review: 'badge-under-review', approved: 'badge-approved', rejected: 'badge-rejected' };
                %>
                <tr>
                  <td>
                    <div class="table-title"><%= s.title %></div>
                    <div class="table-sub"><%= s.orientation %></div>
                  </td>
                  <td style="color:var(--ink-2)"><%= s.genre %></td>
                  <td style="color:var(--ink-2)"><%= s.version %></td>
                  <td>
                    <span class="<%= statusCls[s.status] || 'badge-draft' %>">
                      <span class="badge-dot"></span>
                      <%= statusLabel[s.status] || s.status %>
                    </span>
                  </td>
                  <td class="table-sub"><%= new Date(s.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></td>
                  <td>
                    <a href="/developer/submissions/<%= s.id %>" class="btn ghost sm">Details</a>
                  </td>
                </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>
</body>
</html>
