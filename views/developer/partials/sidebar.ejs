<!-- Mobile backdrop -->
<div class="sidebar-overlay" id="devOverlay"></div>

<aside class="sidebar" id="devSidebar">
  <!-- Brand -->
  <div class="brand">
    <a href="/"><img src="/images/play_logo.png" alt="PlayMist" class="brand-logo-img" /></a>
  </div>

  <div class="nav-section">Main</div>

  <a href="/developer/dashboard" class="nav-item <%= activePage === 'dashboard' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>
      <rect x="14" y="14" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/>
    </svg>
    <span class="nav-label">Dashboard</span>
  </a>

  <a href="/developer/projects" class="nav-item <%= activePage === 'projects' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/>
    </svg>
    <span class="nav-label">Projects</span>
  </a>

  <a href="/developer/submit" class="nav-item <%= activePage === 'submit' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/>
    </svg>
    <span class="nav-label">Submit Your Game</span>
  </a>

  <div class="nav-section">Tools</div>

  <a href="/developer/knowledge" class="nav-item <%= activePage === 'knowledge' ? 'active' : '' %>">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
      <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
    </svg>
    <span class="nav-label">Knowledge Sphere</span>
  </a>

  <div class="sidebar-spacer"></div>

  <div class="nav-section">Account</div>

  <!-- User tile — links to profile -->
  <a href="/developer/profile" class="user-tile <%= activePage === 'profile' ? 'active' : '' %>" style="text-decoration:none;">
    <div class="avatar md">
      <% if (developer.avatar_url) { %><img src="<%= developer.avatar_url %>" alt=""><% } else { %><%= developer.name.charAt(0).toUpperCase() %><% } %>
    </div>
    <div class="meta">
      <div class="name"><%= developer.name %></div>
      <div class="role"><%= developer.studio_name %></div>
    </div>
  </a>

  <a href="/developer/logout" class="nav-item" style="margin-top:4px;color:var(--danger);">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
      <path d="M9 21H5a2 2 0 01-2-2V5a2 2 0 012-2h4M16 17l5-5-5-5M21 12H9"/>
    </svg>
    <span class="nav-label">Log out</span>
  </a>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const sidebar = document.getElementById('devSidebar');
    const overlay = document.getElementById('devOverlay');
    const menuBtn = document.getElementById('devMenuBtn');

    function openSidebar() {
      sidebar.classList.add('open');
      overlay.classList.add('open');
      document.body.style.overflow = 'hidden';
    }
    function closeSidebar() {
      sidebar.classList.remove('open');
      overlay.classList.remove('open');
      document.body.style.overflow = '';
    }

    if (menuBtn) menuBtn.addEventListener('click', openSidebar);
    overlay.addEventListener('click', closeSidebar);

    sidebar.querySelectorAll('.nav-item, .user-tile').forEach(function (link) {
      link.addEventListener('click', function () {
        if (window.innerWidth <= 768) closeSidebar();
      });
    });
  });
</script>
