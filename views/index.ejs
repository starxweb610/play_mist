<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= appName %> – Play Free Games in Your Browser</title>
  <meta name="description" content="Playmist is a free web gaming portal. Play 50+ instant WebGL games right in your browser — no download, no account needed. Also available on Android." />
  <meta name="keywords" content="playmist, play games online, free browser games, webgl games, instant play games, gaming portal" />
  <meta name="author" content="Playmist" />
  <link rel="canonical" href="<%= appUrl %>" />

  <meta property="og:title" content="<%= appName %> – Play Free Games in Your Browser" />
  <meta property="og:description" content="Jump into 50+ instant games right in your browser. No download, no account. Always free." />
  <meta property="og:url" content="<%= appUrl %>" />
  <meta property="og:type" content="website" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Playmist – Free Browser Gaming Portal" />
  <meta name="twitter:description" content="Play 50+ instant games in your browser. No download required." />

  <!-- Fonts: match the mobile app exactly -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800;12..96,900&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="/css/style.css" />
  <link rel="icon" href="/favicon.ico" />
</head>
<body>

  <%- include('partials/navbar', { appName }) %>

  <!-- ─── HERO ─────────────────────────────────────────────────────────── -->
  <section class="hero" id="hero">
    <div class="hero-bg-image" aria-hidden="true"></div>
    <div class="hero-bg-overlay" aria-hidden="true"></div>
    <div class="hero-mist" aria-hidden="true">
      <div class="mist-orb mist-orb-1"></div>
      <div class="mist-orb mist-orb-2"></div>
      <div class="mist-orb mist-orb-3"></div>
    </div>

    <div class="hero-inner">
      <div class="hero-centered">

        <div class="hero-kicker">
          <span class="kicker-dot"></span>
          <span>Free to play · Web + Mobile</span>
        </div>

        <h1 class="hero-title">
          Play Games.<br />
          <span class="line-accent">No Downloads.</span>
        </h1>

        <p class="hero-subtitle">
          Jump into <%= stats.totalGames %>+ instant WebGL games right here in your browser.
          No installs, no account required. Just pick a game and play.
        </p>

        <div class="hero-actions">
          <a href="/games" class="btn btn-primary">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Start Playing Free
          </a>
          <a href="#download" class="btn btn-ghost">
            Get the App
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>

        <div class="hero-stats">
          <div class="stat-item">
            <span class="stat-value"><%= stats.totalGames %>+</span>
            <span class="stat-label">Games</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= stats.totalUsers %></span>
            <span class="stat-label">Players</span>
          </div>
          <div class="stat-item">
            <span class="stat-value"><%= stats.rating %> ★</span>
            <span class="stat-label">Rating</span>
          </div>
          <div class="stat-item">
            <span class="stat-value">Free</span>
            <span class="stat-label">Always</span>
          </div>
        </div>

      </div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <div class="scroll-pip"></div>
      <span>Scroll</span>
    </div>
  </section>

  <!-- ─── PLAY IN BROWSER PROMO ─────────────────────────────────────────── -->
  <section class="section" style="padding-top: 0">
    <div class="container">
      <div class="web-play-banner" data-aos="fade-up">
        <div>
          <span class="banner-tag-mono">No download required</span>
          <h2 class="web-play-title">
            Your browser<br />is your console.
          </h2>
          <p class="web-play-sub">
            Every instant game on Playmist runs directly in your browser via WebGL.
            Open a link, play immediately — on any device with a screen and a connection.
          </p>
          <div class="web-play-pills">
            <span class="pill"><span class="pill-dot"></span>Works on desktop</span>
            <span class="pill"><span class="pill-dot"></span>Works on mobile web</span>
            <span class="pill"><span class="pill-dot"></span>No account needed</span>
          </div>
        </div>
        <div class="web-play-graphic" aria-hidden="true">
          <div class="mini-card" style="--d:3.2s; --delay:0s">🎯</div>
          <div class="mini-card" style="--d:3.8s; --delay:-0.8s">🏎️</div>
          <div class="mini-card" style="--d:2.8s; --delay:-1.6s">🧩</div>
          <div class="mini-card" style="--d:4.2s; --delay:-2.4s">⚔️</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── GAMES SHOWCASE ───────────────────────────────────────────────── -->
  <section class="section games-section" id="games">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Game Library</span>
        <h2 class="section-title">Pick a game.<br /><span class="gradient-text">Start playing.</span></h2>
        <p class="section-subtitle">Two categories. Instant web games you play here, and premium offline titles in the app.</p>
      </div>

      <div class="games-tabs" role="tablist">
        <button class="games-tab active" id="tab-instant" role="tab" aria-selected="true" aria-controls="panel-instant" data-tab="instant">
          Instant — Play in Browser
        </button>
        <button class="games-tab" id="tab-premium" role="tab" aria-selected="false" aria-controls="panel-premium" data-tab="premium">
          Premium — Get the App
        </button>
      </div>

      <div id="panel-instant" class="games-panel active" role="tabpanel" aria-labelledby="tab-instant">
        <% if (webglGames.length > 0) { %>
          <div class="games-grid">
            <% webglGames.forEach((g, i) => { %>
              <a href="/games/<%= g.slug %>" class="game-card lib-card" data-aos="zoom-in" data-aos-delay="<%= (i % 8) * 55 %>">
                <div class="game-thumb game-thumb--img">
                  <% if (g.thumbnail) { %>
                    <img src="<%= g.thumbnail %>" alt="<%= g.title %>" loading="lazy" />
                  <% } else { %>
                    <div class="game-thumb-fallback">🎮</div>
                  <% } %>
                  <% if (g.playable) { %>
                    <span class="play-overlay">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      Play Now
                    </span>
                  <% } %>
                </div>
                <div class="game-info">
                  <h4><%= g.title %></h4>
                  <span class="game-genre"><%= g.genre %></span>
                </div>
                <div class="game-badge">FREE</div>
              </a>
            <% }) %>
          </div>
          <p class="games-more">No install needed. <a href="/games?type=webgl">Browse all instant games →</a></p>
        <% } else { %>
          <p class="games-more">New instant games are on the way — check back soon!</p>
        <% } %>
      </div>

      <div id="panel-premium" class="games-panel" role="tabpanel" aria-labelledby="tab-premium">
        <% if (premiumGames.length > 0) { %>
          <div class="games-grid">
            <% premiumGames.forEach((g, i) => { %>
              <a href="/games/<%= g.slug %>" class="game-card lib-card" data-aos="zoom-in" data-aos-delay="<%= (i % 8) * 55 %>">
                <div class="game-thumb game-thumb--img">
                  <% if (g.thumbnail) { %>
                    <img src="<%= g.thumbnail %>" alt="<%= g.title %>" loading="lazy" />
                  <% } else { %>
                    <div class="game-thumb-fallback">🎮</div>
                  <% } %>
                </div>
                <div class="game-info">
                  <h4><%= g.title %></h4>
                  <span class="game-genre"><%= g.genre %></span>
                </div>
                <div class="game-badge game-badge--premium">OFFLINE</div>
              </a>
            <% }) %>
          </div>
          <p class="games-more">Available inside the <%= appName %> app. <a href="/games?type=premium">Browse premium titles →</a></p>
        <% } else { %>
          <p class="games-more">Premium offline titles are coming soon.</p>
        <% } %>
      </div>

      <div class="games-cta">
        <a href="/games" class="btn btn-ghost">
          View Full Library
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── FEATURES ─────────────────────────────────────────────────────── -->
  <section class="section features" id="features">
    <div class="container">
      <div class="section-header">
        <span class="section-tag">Why Playmist</span>
        <h2 class="section-title">Less friction.<br /><span class="gradient-text">More gaming.</span></h2>
        <p class="section-subtitle">We rebuilt mobile gaming from scratch — one platform for every game, every device.</p>
      </div>

      <div class="features-grid">

        <div class="feature-card feature-card--large" data-aos="fade-up"
             style="--grad-card: linear-gradient(145deg, rgba(181,255,107,0.05), rgba(92,227,232,0.03))">
          <div class="feature-icon-wrap"
               style="--icon-bg: rgba(181,255,107,0.12); --icon-border: rgba(181,255,107,0.22); --icon-color: #8fcc4a">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polygon points="5 3 19 12 5 21 5 3"/>
            </svg>
          </div>
          <h3 class="feature-title">Instant WebGL Games</h3>
          <p class="feature-desc">Click and play — no install, no wait. Our browser-native WebGL games launch in seconds on any device. Perfect for a quick session anywhere, anytime.</p>
          <div class="feature-chips">
            <span class="chip chip--lime">Zero Download</span>
            <span class="chip chip--lime">Instant Launch</span>
          </div>
        </div>

        <div class="feature-card" data-aos="fade-up" data-aos-delay="80">
          <div class="feature-icon-wrap"
               style="--icon-bg: rgba(92,227,232,0.1); --icon-border: rgba(92,227,232,0.2); --icon-color: #5CE3E8">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <line x1="1" y1="1" x2="23" y2="23"/>
              <path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55M5 12.55a10.94 10.94 0 0 1 5.17-2.39M10.71 5.05A16 16 0 0 1 22.56 9M1.42 9a15.91 15.91 0 0 1 4.7-2.88M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/>
            </svg>
          </div>
          <h3 class="feature-title">Premium Offline Games</h3>
          <p class="feature-desc">Download once in the app and play without any connection. Console-quality experiences that live on your device.</p>
        </div>

        <div class="feature-card" data-aos="fade-up" data-aos-delay="120">
          <div class="feature-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"/>
              <line x1="8" y1="21" x2="16" y2="21"/>
              <line x1="12" y1="17" x2="12" y2="21"/>
            </svg>
          </div>
          <h3 class="feature-title">One Library, Every Device</h3>
          <p class="feature-desc">Play the same games in your browser on desktop, or download the app on Android. Your account follows you everywhere.</p>
        </div>

        <div class="feature-card" data-aos="fade-up" data-aos-delay="160">
          <div class="feature-icon-wrap"
               style="--icon-bg: rgba(232,194,92,0.1); --icon-border: rgba(232,194,92,0.2); --icon-color: #E8C25C">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
            </svg>
          </div>
          <h3 class="feature-title">Leaderboards & Rewards</h3>
          <p class="feature-desc">Climb global leaderboards, unlock achievements, and earn credits as you play — all tracked across your profile.</p>
        </div>

        <div class="feature-card" data-aos="fade-up" data-aos-delay="200">
          <div class="feature-icon-wrap"
               style="--icon-bg: rgba(255,107,168,0.1); --icon-border: rgba(255,107,168,0.2); --icon-color: #FF6BA8">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          </div>
          <h3 class="feature-title">Safe & Transparent</h3>
          <p class="feature-desc">Family-safe with optional reward ads. No aggressive pop-ups, no hidden permissions. Gaming the way it should be.</p>
        </div>

        <div class="feature-card feature-card--large" data-aos="fade-up" data-aos-delay="240"
             style="--grad-card: linear-gradient(145deg, rgba(155,125,255,0.06), rgba(92,227,232,0.03))">
          <div class="feature-icon-wrap">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/>
              <polyline points="17 6 23 6 23 12"/>
            </svg>
          </div>
          <h3 class="feature-title">Always Growing</h3>
          <p class="feature-desc">New games land regularly. Our team curates every title for quality before it goes live — so the library stays fresh without getting bloated. Same app, always more to play.</p>
          <div class="feature-chips">
            <span class="chip">New Drops Weekly</span>
            <span class="chip">Curated Quality</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ─── APP DOWNLOAD CTA ─────────────────────────────────────────────── -->
  <section class="section download-section" id="download">
    <div class="download-bg-glow" aria-hidden="true"></div>
    <div class="container">
      <div class="download-wrapper" data-aos="fade-up">
        <div class="download-content">
          <span class="banner-tag-mono" style="margin-bottom:16px; display:block">Also on mobile</span>
          <h2 class="download-title">
            Take <%= appName %> with you.<br />
            <span class="gradient-text">Offline. Anywhere.</span>
          </h2>
          <p class="download-subtitle">
            The app adds premium offline games, a full leaderboard system, achievements, streaks, and daily challenges — on top of all the browser games you already love.
          </p>
          <div class="store-buttons">
            <a href="<%= androidUrl %>" class="store-btn" target="_blank" rel="noopener noreferrer" aria-label="Download on Google Play">
              <img src="/images/playstore.png" class="store-icon" alt="Google Play" />
              <div class="store-text">
                <span class="store-label">Get it on</span>
                <span class="store-name">Google Play</span>
              </div>
            </a>
          </div>
          <div class="download-note">
            <span>Free to download</span>
            <span>Android 7+</span>
            <span>No account to start</span>
          </div>
        </div>
        <div class="download-visual">
          <div class="qr-card">
            <img src="/images/qr-download.png" alt="Scan to download Playmist on Android" class="qr-img" />
            <span class="qr-caption">Scan to download</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ─── PUBLISH WITH US ─────────────────────────────────────────────── -->
  <section class="section" style="padding-bottom:80px">
    <div class="container">
      <div class="web-play-banner" style="background:linear-gradient(135deg,rgba(124,58,237,.12),rgba(167,139,250,.06));border-color:rgba(124,58,237,.3)" data-aos="fade-up">
        <div>
          <span class="banner-tag-mono">For Developers</span>
          <h2 class="web-play-title">
            Built a game?<br />Publish it here.
          </h2>
          <p class="web-play-sub">
            Upload your HTML5 game ZIP, and after a quick review it goes live on PlayMist — reaching thousands of players instantly. Free to submit. Your studio name, your credit.
          </p>
          <div class="web-play-pills">
            <span class="pill"><span class="pill-dot" style="background:#a78bfa"></span>Free to submit</span>
            <span class="pill"><span class="pill-dot" style="background:#a78bfa"></span>Quick review process</span>
            <span class="pill"><span class="pill-dot" style="background:#a78bfa"></span>Your studio name shown</span>
          </div>
          <div style="margin-top:24px;display:flex;gap:12px;flex-wrap:wrap">
            <a href="/developer/signup" class="btn btn-primary">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4M17 8l-5-5-5 5M12 3v12"/></svg>
              Publish a Game
            </a>
            <a href="/developer/login" class="btn btn-ghost">Developer Login</a>
          </div>
        </div>
        <div class="web-play-graphic" aria-hidden="true">
          <div class="mini-card" style="--d:3.2s;--delay:0s;font-size:1.6rem">🕹️</div>
          <div class="mini-card" style="--d:3.8s;--delay:-0.8s;font-size:1.6rem">🚀</div>
          <div class="mini-card" style="--d:2.8s;--delay:-1.6s;font-size:1.6rem">💻</div>
          <div class="mini-card" style="--d:4.2s;--delay:-2.4s;font-size:1.6rem">🎯</div>
        </div>
      </div>
    </div>
  </section>

  <%- include('partials/footer', { appName }) %>

  <script src="/js/main.js"></script>
</body>
</html>
