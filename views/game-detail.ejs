<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <%- include('partials/analytics') %>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- SEO -->
  <title><%= title %></title>
  <meta name="description" content="<%= (game.shortDesc || game.longDesc || '').slice(0, 160) %>" />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href="<%= appUrl %>/games/<%= game.slug %>" />

  <!-- Open Graph -->
  <meta property="og:title" content="<%= game.title %> – <%= appName %>" />
  <meta property="og:description" content="<%= (game.shortDesc || game.longDesc || '').slice(0, 160) %>" />
  <meta property="og:url" content="<%= appUrl %>/games/<%= game.slug %>" />
  <meta property="og:type" content="website" />
  <meta property="og:image" content="<%= game.thumbnail || appUrl + '/images/og-default.png' %>" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content="<%= appName %>" />

  <!-- Twitter Card -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="<%= game.title %> – <%= appName %>" />
  <meta name="twitter:description" content="<%= (game.shortDesc || game.longDesc || '').slice(0, 160) %>" />
  <meta name="twitter:image" content="<%= game.thumbnail || appUrl + '/images/og-default.png' %>" />

  <!-- JSON-LD: VideoGame -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "VideoGame",
    "name": "<%= game.title.replace(/"/g, '&quot;') %>",
    "description": "<%= (game.shortDesc || game.longDesc || '').replace(/"/g, '&quot;').slice(0, 300) %>",
    "url": "<%= appUrl %>/games/<%= game.slug %>",
    "image": "<%= game.thumbnail || appUrl + '/images/og-default.png' %>",
    "genre": "<%= game.genre %>",
    "applicationCategory": "Game",
    "operatingSystem": "Web Browser",
    "publisher": {
      "@type": "Organization",
      "name": "<%= game.studio || appName %>",
      "@id": "<%= appUrl %>/#organization"
    }<% if (game.playable) { %>,
    "playMode": "SinglePlayer",
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD",
      "availability": "https://schema.org/InStock"
    }<% } %>
  }
  </script>

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800;12..96,900&family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

  <!-- Stylesheet -->
  <link rel="stylesheet" href="/css/style.css?v=<%= assetV %>" />
  <link rel="stylesheet" href="/css/profile.css?v=<%= assetV %>" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.ico" />
</head>
<body>

  <%- include('partials/navbar', { appName, scrolled: true }) %>

  <!-- ─── GAME HERO ────────────────────────────────────────────────────── -->
  <header class="game-hero">
    <div class="game-hero-bg" aria-hidden="true">
      <% if (game.thumbnail) { %><img src="<%= game.thumbnail %>" alt="" /><% } %>
      <div class="game-hero-overlay"></div>
    </div>
    <div class="container game-hero-content">
      <a href="/games" class="back-link">← Back to Library</a>
      <div class="game-hero-main">
        <div class="game-hero-thumb" data-aos="zoom-in">
          <% if (game.thumbnail) { %>
            <img src="<%= game.thumbnail %>" alt="<%= game.title %>" />
          <% } else { %>
            <div class="game-thumb-fallback game-thumb-fallback--lg">🎮</div>
          <% } %>
        </div>
        <div class="game-hero-info" data-aos="fade-left" data-aos-delay="90">
          <div class="game-hero-badges" data-aos="fade-left" data-aos-delay="140">
            <span class="game-badge <%= game.type === 'premium' ? 'game-badge--premium' : '' %>"><%= game.type === 'premium' ? 'OFFLINE · PREMIUM' : 'FREE · INSTANT PLAY' %></span>
            <% if (game.flag) { %><span class="game-badge game-badge--flag"><%= game.flag %></span><% } %>
          </div>
          <h1 class="game-hero-title" data-aos="fade-left" data-aos-delay="180"><%= game.title %></h1>
          <p class="game-hero-desc"><%= game.shortDesc %></p>
          <div class="game-hero-meta" data-aos="fade-left" data-aos-delay="230">
            <span class="meta-item"><strong><%= game.genre %></strong> Genre</span>
            <% if (game.rating) { %><span class="meta-item"><strong>⭐ <%= game.rating %></strong> Rating</span><% } %>
            <% if (game.plays) { %><span class="meta-item"><strong><%= game.plays %></strong> Plays</span><% } %>
            <span class="meta-item"><strong><%= game.studio %></strong> Studio</span>
          </div>
          <% if (developer && developer.handle) { %>
            <a href="/@<%= developer.handle %>" class="dev-credit">
              <span class="pf-avatar pf-avatar--xs">
                <% if (developer.avatar_url) { %><img src="<%= developer.avatar_url %>" alt="" /><% } else { %><%= developer.name.charAt(0).toUpperCase() %><% } %>
              </span>
              <span>
                <span class="dev-credit-label">Made by</span>
                <span class="dev-credit-name"><%= developer.name %> <span class="dev-credit-handle">@<%= developer.handle %></span></span>
              </span>
            </a>
          <% } %>
          <% if (game.tags && game.tags.length > 0) { %>
            <div class="feature-tags game-hero-tags">
              <% game.tags.forEach(tag => { %><span class="tag"><%= tag %></span><% }) %>
            </div>
          <% } %>
          <div class="game-hero-actions" data-aos="fade-left" data-aos-delay="280">
            <% if (game.playable) { %>
              <a href="/play/<%= game.slug %>" class="btn btn-primary">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                Play Now — Free
              </a>
              <a href="<%= appIntentUrl %>" class="btn btn-ghost">Open in App</a>
            <% } else { %>
              <a href="<%= appIntentUrl %>" class="btn btn-primary">
                Get the App to Play
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
              </a>
            <% } %>
            <% if (game.type === 'premium') { %>
              <span class="game-hero-hint">📱 This is a premium offline game — playable inside the <%= appName %> app.</span>
            <% } %>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ─── DETAILS ──────────────────────────────────────────────────────── -->
  <section class="section game-detail-section">
    <div class="container game-detail-layout">
      <div class="game-detail-main">
        <% if (game.longDesc) { %>
          <div class="detail-block" data-aos="fade-up">
            <h2 class="detail-block-title">About this game</h2>
            <p class="detail-block-text"><%= game.longDesc %></p>
          </div>
        <% } %>

        <% if (game.trailerUrl) { %>
          <div class="detail-block" data-aos="fade-up">
            <h2 class="detail-block-title">Trailer</h2>
            <video class="game-trailer" src="<%= game.trailerUrl %>" controls preload="none"></video>
          </div>
        <% } %>

        <% if (game.screenshots && game.screenshots.length > 0) { %>
          <div class="detail-block" data-aos="fade-up">
            <h2 class="detail-block-title">Screenshots</h2>
            <div class="screenshot-grid" data-aos="fade-up" data-aos-delay="80">
              <% game.screenshots.forEach(s => { %>
                <a href="<%= s %>" target="_blank" rel="noopener noreferrer" class="screenshot-item">
                  <img src="<%= s %>" alt="<%= game.title %> screenshot" loading="lazy" />
                </a>
              <% }) %>
            </div>
          </div>
        <% } %>
      </div>

      <aside class="game-detail-sidebar">
        <div class="info-card" data-aos="fade-left" data-aos-delay="120">
          <h3 class="form-card-title">Game Info</h3>
          <dl class="info-list">
            <div class="info-row"><dt>Type</dt><dd><%= game.type === 'premium' ? 'Premium (Offline)' : 'Instant (WebGL)' %></dd></div>
            <div class="info-row"><dt>Genre</dt><dd><%= game.genre %></dd></div>
            <div class="info-row"><dt>Orientation</dt><dd><%= game.orientation === 'portrait' ? '📱 Portrait' : '🖥️ Landscape' %></dd></div>
            <div class="info-row"><dt>Studio</dt><dd><%= game.studio %></dd></div>
            <% if (developer && developer.handle) { %>
              <div class="info-row"><dt>Developer</dt><dd><a href="/@<%= developer.handle %>" class="info-link">@<%= developer.handle %></a></dd></div>
            <% } %>
            <div class="info-row"><dt>Version</dt><dd><%= game.version %></dd></div>
            <% if (game.size) { %><div class="info-row"><dt>Size</dt><dd><%= game.size %></dd></div><% } %>
            <% if (game.rating) { %><div class="info-row"><dt>Rating</dt><dd>⭐ <%= game.rating %></dd></div><% } %>
            <% if (game.type === 'webgl' && game.creditsCost > 0) { %>
              <div class="info-row"><dt>Credits</dt><dd><%= game.creditsCost %> / play in-app</dd></div>
            <% } %>
          </dl>
          <% if (game.playable) { %>
            <a href="/play/<%= game.slug %>" class="btn btn-primary" style="width:100%;justify-content:center;margin-top:16px">▶ Play Now</a>
          <% } %>
        </div>
      </aside>
    </div>
  </section>

  <!-- ─── DEVELOPER COMMENTS ───────────────────────────────────────────── -->
  <section class="section gc-section" id="comments">
    <div class="container">
      <div class="gc" id="gameComments" data-game-id="<%= game.id %>" data-max="<%= commentMax %>">
        <div class="gc-head">
          <h2 class="detail-block-title">Developer comments <span class="gc-count" data-comment-count><%= commentTotal %></span></h2>
          <p class="gc-sub">Feedback and shout-outs from indie developers on <%= appName %>.</p>
        </div>

        <% if (commenter) { %>
          <form class="gc-form" data-comment-form novalidate>
            <span class="pf-avatar pf-avatar--xs" aria-hidden="true">
              <% if (commenter.avatarUrl) { %><img src="<%= commenter.avatarUrl %>" alt="" /><% } else { %><%= (commenter.name || '?').charAt(0).toUpperCase() %><% } %>
            </span>
            <div class="gc-form-main">
              <label for="gcBody" class="pf-sr-only">Your comment</label>
              <textarea id="gcBody" name="body" rows="3" placeholder="Share feedback with the developer…"></textarea>
              <div class="gc-form-foot">
                <span class="gc-error" data-comment-error role="alert"></span>
                <span class="gc-counter" data-comment-counter>0 / <%= commentMax %></span>
                <button type="submit" class="btn btn-primary pf-btn pf-btn--sm">Post</button>
              </div>
            </div>
          </form>
        <% } else { %>
          <div class="gc-login">
            <p><strong>Are you a game developer?</strong> Log in with your <%= appName %> developer account to join the conversation.</p>
            <div class="gc-login-actions">
              <a href="/developer/login?next=<%= encodeURIComponent('/games/' + game.slug + '#comments') %>" class="btn btn-primary pf-btn pf-btn--sm">Log in</a>
              <a href="/developer/signup" class="btn btn-ghost pf-btn pf-btn--sm">Create account</a>
            </div>
          </div>
        <% } %>

        <div class="gc-list" data-comment-list>
          <% comments.forEach(c => { %>
            <article class="gc-item" data-comment-id="<%= c.id %>">
              <% if (c.author.handle) { %><a href="/@<%= c.author.handle %>" class="pf-avatar pf-avatar--xs"><% } else { %><span class="pf-avatar pf-avatar--xs"><% } %>
                <% if (c.author.avatarUrl) { %><img src="<%= c.author.avatarUrl %>" alt="" /><% } else { %><%= (c.author.name || '?').charAt(0).toUpperCase() %><% } %>
              <% if (c.author.handle) { %></a><% } else { %></span><% } %>
              <div class="gc-item-main">
                <div class="gc-item-head">
                  <% if (c.author.handle) { %>
                    <a href="/@<%= c.author.handle %>" class="gc-author"><%= c.author.name %></a>
                    <span class="gc-handle">@<%= c.author.handle %></span>
                  <% } else { %>
                    <span class="gc-author"><%= c.author.name %></span>
                  <% } %>
                  <time class="gc-time" datetime="<%= new Date(c.createdAt).toISOString() %>"><%= new Date(c.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></time>
                  <% if (c.canDelete) { %><button type="button" class="gc-delete" data-delete-comment="<%= c.id %>">Delete</button><% } %>
                </div>
                <p class="gc-body"><%= c.body %></p>
              </div>
            </article>
          <% }) %>
          <p class="gc-empty" data-comment-empty <%= comments.length ? 'hidden' : '' %>>No comments yet.<%= commenter ? ' Be the first to leave feedback.' : '' %></p>
        </div>
        <% if (commentTotal > comments.length) { %>
          <p class="gc-more">Showing the latest <%= comments.length %> of <%= commentTotal %> comments.</p>
        <% } %>
      </div>
    </div>
  </section>

  <!-- ─── RELATED GAMES ────────────────────────────────────────────────── -->
  <% if (relatedGames.length > 0) { %>
    <section class="section related-section">
      <div class="container">
        <div class="section-header">
          <span class="section-tag">More like this</span>
          <h2 class="section-title">You might also <span class="gradient-text">enjoy</span></h2>
        </div>
        <div class="games-grid library-grid">
          <% relatedGames.forEach((g, i) => { %>
            <a href="/games/<%= g.slug %>" class="game-card lib-card" data-aos="zoom-in" data-aos-delay="<%= i * 60 %>">
              <div class="game-thumb game-thumb--img">
                <% if (g.thumbnail) { %>
                  <img src="<%= g.thumbnail %>" alt="<%= g.title %>" loading="lazy" />
                <% } else { %>
                  <div class="game-thumb-fallback">🎮</div>
                <% } %>
                <% if (g.playable) { %><span class="play-overlay">▶ Play Now</span><% } %>
              </div>
              <div class="game-info">
                <h4><%= g.title %></h4>
                <span class="game-genre"><%= g.genre %></span>
              </div>
              <% if (g.type === 'premium') { %><div class="game-badge game-badge--premium">OFFLINE</div><% } %>
            </a>
          <% }) %>
        </div>
      </div>
    </section>
  <% } %>

  <%- include('partials/footer', { appName }) %>

  <script src="/js/main.js"></script>
  <script src="/js/profile.js" defer></script>
</body>
</html>
