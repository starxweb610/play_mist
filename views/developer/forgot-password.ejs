<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" />
  <title>Reset Password — <%= appName %> Developers</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/developer.css" />
</head>
<body>
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-logo">
      <a href="/"><img src="/images/play_logo.png" alt="<%= appName %>" class="auth-logo-img" /></a>
      <p class="auth-sub">Developer Portal</p>
    </div>

    <h2>Forgot your password?</h2>
    <p class="auth-desc">Enter your account email and we'll send you a 6-digit code to reset your password.</p>

    <% if (errors && errors.length > 0) { %>
      <div class="flash flash-error">
        <% if (errors.length === 1) { %><%= errors[0] %>
        <% } else { %><ul><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul><% } %>
      </div>
    <% } %>

    <form method="POST" action="/developer/forgot-password">
      <div class="form-group" style="margin-bottom:20px;">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@studio.com" value="<%= (form && form.email) ? form.email : '' %>" />
      </div>
      <button type="submit" class="btn primary btn-full">Send Reset Code</button>
    </form>

    <div class="auth-link" style="margin-top:24px;">
      Remembered it? <a href="/developer/login">Back to login</a>
    </div>
  </div>
</div>
</body>
</html>
