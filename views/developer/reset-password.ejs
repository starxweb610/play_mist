<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" href="/favicon.ico" />
  <title>Reset Password — <%= appName %> Developers</title>
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/developer.css" />
  <style>
    .otp-row {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin: 8px 0;
    }
    .otp-input {
      width: 48px;
      height: 56px;
      text-align: center;
      font-size: 22px;
      font-weight: 700;
      border-radius: 10px;
      border: 1.5px solid rgba(255,255,255,.12);
      background: rgba(255,255,255,.04);
      color: #f9fafb;
      outline: none;
      transition: border-color .15s, box-shadow .15s;
      caret-color: transparent;
    }
    .otp-input:focus {
      border-color: #B5FF6B;
      box-shadow: 0 0 0 3px rgba(181,255,107,.15);
    }
    .otp-input.filled { border-color: rgba(181,255,107,.35); }
    .resend-row {
      text-align: center;
      margin-top: 18px;
      font-size: .875rem;
      color: #6b7280;
    }
    .resend-btn {
      background: none;
      border: none;
      color: #B5FF6B;
      cursor: pointer;
      font-size: .875rem;
      padding: 0;
      text-decoration: underline;
    }
    .resend-btn:disabled {
      color: #4b5563;
      cursor: default;
      text-decoration: none;
    }
    .email-highlight { color: #a78bfa; font-weight: 600; word-break: break-all; }
    #resendMsg { margin-top: 8px; font-size: .8rem; min-height: 16px; }
    #resendMsg.ok  { color: #4ade80; }
    #resendMsg.err { color: #f87171; }
    #countdown { color: #6b7280; }
  </style>
</head>
<body>
<div class="auth-page">
  <div class="auth-card" style="max-width:460px;">
    <div class="auth-logo">
      <a href="/"><img src="/images/play_logo.png" alt="<%= appName %>" class="auth-logo-img" /></a>
      <p class="auth-sub">Developer Portal</p>
    </div>

    <h2 style="text-align:center;">Reset your password</h2>
    <p class="auth-desc" style="text-align:center;">
      Enter the 6-digit code we sent to<br/>
      <span class="email-highlight"><%= email %></span>
      and choose a new password.
    </p>

    <% if (errors && errors.length > 0) { %>
      <div class="flash flash-error">
        <% if (errors.length === 1) { %><%= errors[0] %>
        <% } else { %><ul><% errors.forEach(e => { %><li><%= e %></li><% }); %></ul><% } %>
      </div>
    <% } %>

    <form method="POST" action="/developer/reset-password" id="resetForm" novalidate>
      <input type="hidden" name="code" id="codeHidden" />

      <label style="display:block;margin-bottom:6px;">Verification Code</label>
      <div class="otp-row">
        <% for (let i = 0; i < 6; i++) { %>
          <input
            type="text"
            inputmode="numeric"
            pattern="[0-9]"
            maxlength="1"
            class="otp-input"
            id="otp<%= i %>"
            autocomplete="<%= i === 0 ? 'one-time-code' : 'off' %>"
            aria-label="Digit <%= i + 1 %>"
          />
        <% } %>
      </div>
      <p style="text-align:center;font-size:.8rem;color:#6b7280;margin:0 0 18px;">Code expires in 15 min</p>

      <div class="form-group">
        <label for="new_password">New Password</label>
        <input type="password" id="new_password" name="new_password" required minlength="8" autocomplete="new-password" placeholder="At least 8 characters" />
      </div>
      <div class="form-group" style="margin-bottom:20px;">
        <label for="confirm_password">Confirm New Password</label>
        <input type="password" id="confirm_password" name="confirm_password" required minlength="8" autocomplete="new-password" placeholder="Re-enter new password" />
      </div>

      <button type="submit" class="btn primary btn-full" id="submitBtn">Reset Password</button>
    </form>

    <div class="resend-row">
      Didn't receive a code?
      <button class="resend-btn" id="resendBtn" type="button">Resend code</button>
      <span id="countdown"></span>
      <div id="resendMsg"></div>
    </div>

    <div class="auth-link" style="margin-top:24px;text-align:center;">
      <a href="/developer/login">← Back to login</a>
    </div>
  </div>
</div>

<script>
(function () {
  const inputs    = Array.from(document.querySelectorAll('.otp-input'));
  const hidden    = document.getElementById('codeHidden');
  const form      = document.getElementById('resetForm');
  const resendBtn = document.getElementById('resendBtn');
  const countdown = document.getElementById('countdown');
  const resendMsg = document.getElementById('resendMsg');

  function syncHidden() {
    hidden.value = inputs.map(i => i.value).join('');
    inputs.forEach(i => i.classList.toggle('filled', i.value !== ''));
  }

  inputs.forEach((input, idx) => {
    input.addEventListener('input', e => {
      const val = e.target.value.replace(/\D/g, '');
      if (val.length > 1 && idx === 0) {
        val.slice(0, 6).split('').forEach((ch, i) => { if (inputs[i]) inputs[i].value = ch; });
        (inputs[Math.min(5, val.length - 1)] || inputs[5]).focus();
        syncHidden();
        return;
      }
      input.value = val.slice(-1);
      syncHidden();
      if (val && idx < 5) inputs[idx + 1].focus();
    });

    input.addEventListener('keydown', e => {
      if (e.key === 'Backspace' && !input.value && idx > 0) {
        inputs[idx - 1].focus();
        inputs[idx - 1].value = '';
        syncHidden();
      }
      if (e.key === 'ArrowLeft' && idx > 0)  inputs[idx - 1].focus();
      if (e.key === 'ArrowRight' && idx < 5) inputs[idx + 1].focus();
    });
  });

  form.addEventListener('submit', e => {
    syncHidden();
    if (hidden.value.length !== 6) {
      e.preventDefault();
      inputs[0].focus();
    }
  });

  inputs[0].focus();

  // ── Resend ────────────────────────────────────────────────────────────────
  let cooldown = 0;
  let timer    = null;

  function startCooldown(secs) {
    cooldown = secs;
    resendBtn.disabled = true;
    tick();
    timer = setInterval(tick, 1000);
  }

  function tick() {
    if (cooldown <= 0) {
      clearInterval(timer);
      resendBtn.disabled = false;
      countdown.textContent = '';
      return;
    }
    countdown.textContent = `(${cooldown}s)`;
    cooldown--;
  }

  resendBtn.addEventListener('click', async () => {
    resendMsg.textContent = '';
    resendMsg.className = '';
    resendBtn.disabled = true;

    try {
      const resp = await fetch('/developer/resend-reset', { method: 'POST', headers: { 'Content-Type': 'application/json' } });
      const data = await resp.json();
      if (data.ok) {
        resendMsg.textContent = 'New code sent! Check your inbox.';
        resendMsg.className = 'ok';
        startCooldown(60);
      } else {
        resendMsg.textContent = data.error || 'Failed to resend.';
        resendMsg.className = 'err';
        resendBtn.disabled = false;
      }
    } catch (_) {
      resendMsg.textContent = 'Network error. Try again.';
      resendMsg.className = 'err';
      resendBtn.disabled = false;
    }
  });
})();
</script>
</body>
</html>
