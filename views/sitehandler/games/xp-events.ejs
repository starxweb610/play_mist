<!DOCTYPE html>
<html lang="en">
<head><%- include('../partials/head') %>  <link rel="icon" href="/favicon.ico" /></head>
<body class="admin-body">
<%- include('../partials/sidebar', { activePage, admin, appName }) %>
<div class="admin-main" id="adminMain">
  <%- include('../partials/topbar', { title }) %>
  <div class="flash-container"><%- include('../partials/flash') %></div>
  <main class="admin-content">

    <div class="page-header">
      <div>
        <h2 class="page-heading">XP Events — <%= game.title %></h2>
        <p class="page-subheading">Define what each in-game event is worth. The game only ever reports the event key — never an amount — so this list is the sole source of truth for XP.</p>
      </div>
      <div class="page-header-actions">
        <a href="/sitehandler/games/<%= game.id %>" class="btn-admin-ghost">← Back to Game</a>
      </div>
    </div>

    <!-- ── Add Event ─────────────────────────────────────────────────── -->
    <div class="card" style="margin-bottom:28px;">
      <div class="card-header">
        <h3 class="card-title">Add Event</h3>
      </div>
      <div class="card-body">
        <form method="POST" action="/sitehandler/games/<%= game.id %>/xp-events/create">
          <div style="display:grid;grid-template-columns:1fr 2fr 1fr auto;gap:16px;align-items:end;">
            <div class="form-group" style="margin:0;">
              <label class="form-label">Event Key <span style="color:#e05c5c">*</span></label>
              <input type="text" name="event_key" class="form-control" maxlength="80" placeholder="e.g. coin_collected" required />
            </div>
            <div class="form-group" style="margin:0;">
              <label class="form-label">Name <span style="color:#e05c5c">*</span></label>
              <input type="text" name="name" class="form-control" maxlength="120" placeholder="e.g. Collected a coin" required />
            </div>
            <div class="form-group" style="margin:0;">
              <label class="form-label">XP Reward</label>
              <input type="number" name="xp_reward" class="form-control" min="0" value="10" required />
            </div>
            <button type="submit" class="btn-admin-primary">Add</button>
          </div>
        </form>
      </div>
    </div>

    <!-- ── Events ────────────────────────────────────────────────────── -->
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">Events</h3>
        <span class="admin-badge"><%= events.length %></span>
      </div>
      <div class="card-body" style="padding:0;">
        <% if (events.length === 0) { %>
          <div style="text-align:center;padding:48px 24px;opacity:.5;">No XP events configured yet.</div>
        <% } else { %>
          <table class="data-table">
            <thead>
              <tr>
                <th>Event Key</th>
                <th>Name</th>
                <th>XP Reward</th>
                <th>Status</th>
                <th></th>
              </tr>
            </thead>
            <tbody>
              <% events.forEach(function(e) { %>
                <tr>
                  <td><code><%= e.event_key %></code></td>
                  <td style="min-width:220px;">
                    <form method="POST" action="/sitehandler/games/<%= game.id %>/xp-events/<%= e.id %>/update" style="display:flex;gap:8px;align-items:center;">
                      <input type="text" name="name" class="form-control" value="<%= e.name %>" style="max-width:220px;" />
                      <input type="number" name="xp_reward" class="form-control" min="0" value="<%= e.xp_reward %>" style="max-width:90px;" />
                      <button type="submit" class="action-btn">Save</button>
                    </form>
                  </td>
                  <td style="font-weight:600;"><%= e.xp_reward %></td>
                  <td>
                    <span class="status-badge <%= e.is_active ? 'status-badge--active' : 'status-badge--pending' %>">
                      <%= e.is_active ? 'Active' : 'Disabled' %>
                    </span>
                  </td>
                  <td style="white-space:nowrap;">
                    <form action="/sitehandler/games/<%= game.id %>/xp-events/<%= e.id %>/toggle" method="POST" style="display:inline;">
                      <button type="submit" class="action-btn"><%= e.is_active ? 'Disable' : 'Enable' %></button>
                    </form>
                    <form action="/sitehandler/games/<%= game.id %>/xp-events/<%= e.id %>/delete" method="POST" style="display:inline;">
                      <button type="submit" class="action-btn action-btn--danger"
                        data-confirm="Delete the '<%= e.event_key %>' event? Games still calling reportEvent with this key will simply no-op.">
                        Delete
                      </button>
                    </form>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        <% } %>
      </div>
    </div>

  </main>
</div>
<script src="/sitehandler/js/admin.js"></script>
</body>
</html>
