<%
  /**
   * Genre drawer — sliding panel (homepage).
   *
   * Include this at BODY level, not inside .container: the panel is
   * position: fixed and must outrank the navbar (z-index 1000), which it can
   * only do outside .container's stacking context.
   *
   * Locals:
   *   genres  [{ name, gameCount }]  required
   */
  const drawerGenres = typeof genres !== 'undefined' ? genres : [];
  const drawerTotal  = drawerGenres.reduce((sum, g) => sum + Number(g.gameCount || 0), 0);
  const drawerHref   = (name) => '/games' + (name ? '?genre=' + encodeURIComponent(name) : '');
%>
<% if (drawerGenres.length > 0) { %>
  <!-- Scrim only appears for a click-opened (pinned) drawer, not on hover. -->
  <div class="genre-scrim" id="genreScrim" aria-hidden="true"></div>

  <aside class="genre-drawer" id="genreDrawer" aria-labelledby="genreDrawerTitle" aria-hidden="true">
    <div class="genre-drawer-head">
      <div>
        <span class="genre-drawer-kicker">Game Library</span>
        <h2 class="genre-drawer-title" id="genreDrawerTitle">Browse by genre</h2>
      </div>
      <button type="button" class="genre-drawer-close" id="genreDrawerClose" aria-label="Close genre panel">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M18 6L6 18M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <nav class="genre-drawer-list">
      <a href="<%= drawerHref(null) %>" class="genre-drawer-item active">
        <span class="genre-drawer-name">All Games</span>
        <span class="genre-count"><%= drawerTotal %></span>
        <svg class="genre-option-arrow" width="15" height="15" viewBox="0 0 24 24"
             fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <% drawerGenres.forEach(g => { %>
        <a href="<%= drawerHref(g.name) %>" class="genre-drawer-item">
          <span class="genre-drawer-name"><%= g.name %></span>
          <span class="genre-count"><%= g.gameCount %></span>
          <svg class="genre-option-arrow" width="15" height="15" viewBox="0 0 24 24"
               fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      <% }) %>
    </nav>
  </aside>
<% } %>
